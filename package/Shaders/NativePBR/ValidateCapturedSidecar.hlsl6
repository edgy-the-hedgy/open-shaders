Texture2D<uint> CapturedIdentity : register(t0);
Texture2D<float4> CapturedUvDdx : register(t1);
Texture2D<float4> CapturedDdyDepth : register(t2);
Texture2D<float4> CapturedBasis0 : register(t3);
Texture2D<float4> CapturedBasis1 : register(t4);
Texture2D<float4> CapturedBasis2 : register(t5);
Texture2D<float> OpaqueDepth : register(t6);
RWByteAddressBuffer Report : register(u0);
RWTexture2D<float4> Preview : register(u1);

cbuffer Settings : register(b0)
{
    uint Width;
    uint Height;
    uint DrawCount;
    uint InspectX;
    uint InspectY;
    uint PreviewStep;
    uint PreviewMode;
    uint DepthIs24Bit;
};

void Count(uint slot)
{
    uint unused;
    Report.InterlockedAdd(slot * 4, 1, unused);
}

[numthreads(8, 8, 1)]
void main(uint3 dispatchId : SV_DispatchThreadID)
{
    uint2 pixel = dispatchId.xy;
    if (pixel.x >= Width || pixel.y >= Height)
        return;

    const uint ordinal = CapturedIdentity.Load(int3(pixel, 0));
    const bool covered = ordinal != 0;
    const bool ordinalValid = ordinal > 0 && ordinal <= DrawCount;
    float4 uvDdx = 0, ddyDepth = 0, basis0 = 0, basis1 = 0, basis2 = 0;
    bool uvValid = false, gradientValid = false, basisValid = false, facingValid = false, depthValid = false;
    if (covered) {
        Count(7);
        if (!ordinalValid) Count(1);
        uvDdx = CapturedUvDdx.Load(int3(pixel, 0));
        ddyDepth = CapturedDdyDepth.Load(int3(pixel, 0));
        basis0 = CapturedBasis0.Load(int3(pixel, 0));
        basis1 = CapturedBasis1.Load(int3(pixel, 0));
        basis2 = CapturedBasis2.Load(int3(pixel, 0));
        uvValid = all(isfinite(uvDdx.xy));
        gradientValid = all(isfinite(uvDdx.zw)) && all(isfinite(ddyDepth.xy));
        basisValid = all(isfinite(basis0.xyz)) && all(isfinite(basis1.xyz)) &&
            all(isfinite(basis2.xyz)) && dot(basis0.xyz, basis0.xyz) > 1e-8 &&
            dot(basis1.xyz, basis1.xyz) > 1e-8 && dot(basis2.xyz, basis2.xyz) > 1e-8;
        facingValid = isfinite(ddyDepth.w) && abs(ddyDepth.w) == 1.0;
        const float finalDepth = OpaqueDepth.Load(int3(pixel, 0));
        depthValid = isfinite(ddyDepth.z) && isfinite(finalDepth) &&
            ddyDepth.z >= 0 && ddyDepth.z <= 1 && finalDepth >= 0 && finalDepth <= 1 &&
            (DepthIs24Bit != 0 ? abs(ddyDepth.z - finalDepth) <= 0.5 / 16777215.0 :
                ddyDepth.z == finalDepth);
        if (!uvValid) Count(2);
        if (!gradientValid) Count(3);
        if (!basisValid) Count(4);
        if (!facingValid) Count(5);
        if (!depthValid) Count(6);
        if (ordinalValid && uvValid && gradientValid && basisValid && facingValid && depthValid)
            Count(0);
        if ((pixel.x & 1) == 0 && (pixel.y & 1) == 0 &&
            pixel.x + 1 < Width && pixel.y + 1 < Height &&
            CapturedIdentity.Load(int3(pixel + uint2(1, 0), 0)) == ordinal &&
            CapturedIdentity.Load(int3(pixel + uint2(0, 1), 0)) == ordinal &&
            CapturedIdentity.Load(int3(pixel + uint2(1, 1), 0)) == ordinal) {
            const float2 rightUV = CapturedUvDdx.Load(int3(pixel + uint2(1, 0), 0)).xy;
            const float2 bottomUV = CapturedUvDdx.Load(int3(pixel + uint2(0, 1), 0)).xy;
            if (uvValid && gradientValid && all(isfinite(rightUV)) && all(isfinite(bottomUV))) {
                Count(11);
                const float2 deltaX = rightUV - uvDdx.xy;
                const float2 deltaY = bottomUV - uvDdx.xy;
                if (any(abs(deltaX - uvDdx.zw) > 0.0001) ||
                    any(abs(deltaY - ddyDepth.xy) > 0.0001))
                    Count(10);
            }
        }
    }

    if (pixel.x == InspectX && pixel.y == InspectY) {
        Report.Store(32, ordinal);
        Report.Store(36, (covered ? 1 : 0) | (ordinalValid ? 2 : 0) |
            (uvValid ? 4 : 0) | (gradientValid ? 8 : 0) | (basisValid ? 16 : 0) |
            (facingValid ? 32 : 0) | (depthValid ? 64 : 0));
        Report.Store4(48, asuint(uvDdx));
        Report.Store4(64, asuint(ddyDepth));
        Report.Store4(80, asuint(basis0));
        Report.Store4(96, asuint(basis1));
        Report.Store4(112, asuint(basis2));
    }

    if ((pixel.x % PreviewStep) != 0 || (pixel.y % PreviewStep) != 0)
        return;
    float3 color = 0;
    if (covered) {
        if (PreviewMode == 0) {
            color = float3(0.1, 0.85, 0.2);
        } else if (PreviewMode == 1) {
            uint hash = ordinal * 747796405u + 2891336453u;
            hash ^= hash >> 16;
            color = float3(hash & 255, (hash >> 8) & 255, (hash >> 16) & 255) / 255.0;
        } else if (PreviewMode == 2) {
            color = frac(uvDdx.xyxy).xyx;
        } else if (PreviewMode == 3) {
            color = saturate(float3(length(uvDdx.zw), length(ddyDepth.xy),
                abs(uvDdx.z * ddyDepth.y - uvDdx.w * ddyDepth.x)) * 32.0);
        } else {
            color = saturate(normalize(basis2.xyz) * 0.5 + 0.5);
        }
        if (!ordinalValid || !uvValid || !gradientValid || !basisValid || !facingValid || !depthValid)
            color = float3(1, 0, 1);
    }
    Preview[pixel / PreviewStep] = float4(color, covered ? 1.0 : 0.0);
}
