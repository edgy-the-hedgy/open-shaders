#include "NativeSurface.hlsli"
#include "FullNativeSampling.hlsli"
#include "Common/ColorSpaces.hlsli"
Texture2D<float4> Raw : register(t0);
Texture2D<float> Coverage : register(t1);
TextureCube<float4> Sky : register(t2);
Texture2D<float> OpaqueDepth : register(t3);
Texture2D<float4> Tokens : register(t4);
RaytracingAccelerationStructure Scene : register(t5);
#define NATIVE_GEOMETRY_REGISTER t6
#define NATIVE_RECORD_REGISTER t7
#define NATIVE_BINDING_REGISTER t8
#define NATIVE_TEXTURE_REGISTER t9
#include "NativeMaterialAlpha.hlsli"
RaytracingAccelerationStructure CharacterScene : register(t521);
ByteAddressBuffer RayIdentity : register(t522);
ByteAddressBuffer TokenTable : register(t523);
ByteAddressBuffer Radiance : register(t524);
Texture2D<float4> PreviousRaw : register(t525);
Texture2D<float> PreviousMask : register(t526);
Texture2D<float4> PreviousResult : register(t527);
ByteAddressBuffer SecondaryLights : register(t528);
RWTexture2D<float4> Result : register(u0);
RWTexture2D<float4> Sparse : register(u1);
cbuffer Constants : register(b0)
{
    row_major float4x4 Projection;
    row_major float4x4 InverseProjection;
    row_major float4x4 InverseView;
    row_major float4x4 View;
    float4 PositionAdjust;
    uint2 Size;
    uint2 OutputSize;
    uint HasSky;
    uint Encoding;
    uint Quality;
    uint Frame;
    uint InstanceCount;
    uint CharacterEnabled;
    uint RayPitch;
    uint TokenCount;
    float EmitterRadius;
    uint HasHistory;
    uint2 Padding;
    row_major float4x4 PreviousViewProjection;
    float4 PreviousPositionAdjust;
    float4 SecondarySunDirection,SecondarySunRadiance;
    uint SecondaryLightCount,SecondaryFoliage;
    uint2 SecondaryPadding;
};
#include "NativeSecondaryReflection.hlsli"
cbuffer DispatchPhase : register(b1) { uint Phase; };
uint2 Pixel(float2 uv){return min(uint2(uv*float2(Size)),Size-1u);}
bool Receiver(uint2 pixel,out float3 world,out float3 direction)
{
    world=0;direction=0;
    float2 uv=(float2(pixel)+0.5)/float2(OutputSize);
    uint2 p=Pixel(uv);
    if(!(Coverage.Load(int3(p,0))>0))return false;
    float depth=Raw.Load(int3(p,0)).a;
    if(!isfinite(depth)||depth<=0||depth>=1)return false;
    float4 position=mul(InverseProjection,float4(uv*float2(2,-2)+float2(-1,1),depth,1));
    if(!all(isfinite(position))||abs(position.w)<1e-8)return false;
    float3 v=position.xyz/position.w;
    float4 absolute=mul(InverseView,float4(v,1));
    if(!all(isfinite(absolute))||abs(absolute.w)<1e-8)return false;
    world=absolute.xyz/absolute.w+PositionAdjust.xyz;
    direction=normalize(mul((float3x3)InverseView,v));
    return all(isfinite(world))&&all(isfinite(direction));
}
float3 EncodeRadiance(float3 c)
{
    if(Encoding==0u)return pow(max(c,0.0),1.0/1.6);
    if(Encoding==2u)return max(sRGBToAP1(c),0.0);
    return max(c,0.0);
}
float4 Fallback(float3 direction)
{
    if(HasSky==0u)return 0;
    float3 c=Sky.SampleLevel(ClampClamp,direction,0).rgb;
    return all(isfinite(c))?float4(clamp(c,0,65504),1):0;
}
float4 Trace(uint2 receiver,float3 world,float3 incident)
{
    // Flat world-space water; the normal is oriented toward the receiver side.
    float3 normal=float3(0,0,incident.z<=0?1:-1);
    float3 mirror=reflect(incident,normal);
    float3 direction=normalize(mirror+NativeEmitterOffset(mirror,EmitterRadius*ShadowEmitterMultiplier(Quality),receiver,0u,Frame));
    if(!all(isfinite(direction))||dot(direction,normal)<=0.0)return Fallback(mirror);
    RayDesc ray;
    ray.Origin=world+normal*0.5;ray.Direction=direction;ray.TMin=0.5;ray.TMax=3.402823e38;
    RayQuery<RAY_FLAG_NONE> query;
    query.TraceRayInline(Scene,RAY_FLAG_NONE,0xff,ray);
    while(query.Proceed()){
        if(query.CandidateType()==CANDIDATE_NON_OPAQUE_TRIANGLE&&
           AcceptAlpha(query.CandidateInstanceID(),query.CandidatePrimitiveIndex(),query.CandidateTriangleBarycentrics(),InstanceCount))
            query.CommitNonOpaqueTriangleHit();
    }
    if(query.CommittedStatus()!=COMMITTED_TRIANGLE_HIT)return Fallback(direction);
    float distance=query.CommittedRayT();
    if(CharacterEnabled!=0u){
        ray.TMax=distance;
        RayQuery<RAY_FLAG_FORCE_OPAQUE|RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> character;
        character.TraceRayInline(CharacterScene,RAY_FLAG_NONE,0xff,ray);
        while(character.Proceed()){}
        if(character.CommittedStatus()!=COMMITTED_NOTHING)return Fallback(direction);
    }
    float3 point=ray.Origin+direction*distance;
    float3 secondary;
    if(ShadeNativeSecondary(query.CommittedInstanceID(),query.CommittedPrimitiveIndex(),query.CommittedTriangleBarycentrics(),
        (float3x3)query.CommittedWorldToObject3x4(),(float3x3)query.CommittedObjectToWorld3x4(),query.CommittedTriangleFrontFace(),
        point,direction,distance,EmitterRadius,receiver,0u,Frame,Quality,InstanceCount,CharacterEnabled,
        SecondaryLightCount,SecondarySunDirection,SecondarySunRadiance,SecondaryFoliage,secondary))
        return float4(clamp(EncodeRadiance(secondary),0,65504),1);
    float4 clip=mul(Projection,mul(View,float4(point-PositionAdjust.xyz,1)));
    if(!all(isfinite(clip))||abs(clip.w)<1e-5)return Fallback(direction);
    float2 uv=clip.xy/clip.w*float2(0.5,-0.5)+0.5;
    float depth=clip.z/clip.w;
    if(any(uv<0)||any(uv>=1)||depth<=0||depth>=1)return Fallback(direction);
    uint2 p=Pixel(uv);
    float observed=OpaqueDepth.Load(int3(p,0));
    if(!isfinite(observed)||abs(observed-depth)>0.0005)return Fallback(direction);
    uint token=uint(round(saturate(Tokens.Load(int3(p,0)).b)*65535.0));
    if(token==0||token>TokenCount)return Fallback(direction);
    uint2 identity=RayIdentity.Load2(p.y*RayPitch+p.x*8u);
    uint2 committed=uint2(query.CommittedInstanceID(),query.CommittedPrimitiveIndex());
    if(any(identity==0xffffffffu)||any(uint2(identity.x,identity.y&0x7fffffffu)!=committed)||
       any(TokenTable.Load2((token-1u)*8u)!=committed))return Fallback(direction);
    float4 color=UnpackNativeLobeHalf4(Radiance.Load2((p.y*Size.x+p.x)*8u));
    if(!all(isfinite(color))||color.a!=float(ContributionDirectDiffuse))return Fallback(direction);
    return float4(clamp(EncodeRadiance(color.rgb),0,65504),1);
}
float4 Accumulate(float4 current,float3 world,float3 lo,float3 hi)
{
    if(HasHistory==0u||current.a<=0.0)return current;
    float4 clip=mul(PreviousViewProjection,float4(world-PreviousPositionAdjust.xyz,1));
    if(!all(isfinite(clip))||abs(clip.w)<1e-5)return current;
    float2 uv=clip.xy/clip.w*float2(0.5,-0.5)+0.5;
    float depth=clip.z/clip.w;
    if(any(uv<0)||any(uv>=1)||depth<=0||depth>=1)return current;
    uint2 p=Pixel(uv);
    if(PreviousMask.Load(int3(p,0))<=0.0)return current;
    float oldDepth=PreviousRaw.Load(int3(p,0)).a;
    if(!isfinite(oldDepth)||abs(oldDepth-depth)>0.0005)return current;
    float4 prior=PreviousResult.Load(int3(min(uint2(uv*float2(OutputSize)),OutputSize-1u),0));
    if(!all(isfinite(prior))||prior.a<=0.0)return current;
    if(ShadowClampHistory(Quality))prior.rgb=clamp(prior.rgb,lo,hi);
    return lerp(prior,current,1.0/float(ShadowTemporalFrames(Quality)));
}
[numthreads(8,8,1)]
void main(uint3 id:SV_DispatchThreadID)
{
    if(Phase==0u){
        uint2 p=NativeSamplePixel(id.xy,OutputSize,Quality,Frame);
        if(any(p>=OutputSize))return;
        float3 world,direction;
        Sparse[p]=Receiver(p,world,direction)?Trace(p,world,direction):float4(0,0,0,0);
        return;
    }
    if(any(id.xy>=OutputSize))return;
    uint2 p=id.xy;
    Result[p]=0;
    float3 world,direction;
    if(!Receiver(p,world,direction))return;
    bool direct=NativeIsSampled(p,OutputSize,Quality,Frame)&&!ShadowFilterDirectSamples(Quality);
    int radius=int(ShadowReconstructionRadius(Quality));
    float4 sum=0;float total=0;
    float3 lo=65504.0,hi=0.0;
    [loop]for(int y=-radius;y<=radius;++y)[loop]for(int x=-radius;x<=radius;++x){
        int2 q=int2(p)+int2(x,y);
        if(any(q<0)||any(q>=int2(OutputSize))||!NativeIsSampled(uint2(q),OutputSize,Quality,Frame))continue;
        float3 other,otherDirection;
        if(!Receiver(uint2(q),other,otherDirection)||abs(other.z-world.z)>max(1.0,length(world-PositionAdjust.xyz)*0.001))continue;
        float w=1.0/(1.0+float(x*x+y*y));
        float4 sample=Sparse[q];
        if(!all(isfinite(sample))||sample.a<=0.0)continue;
        sum+=sample*w;total+=w;lo=min(lo,sample.rgb);hi=max(hi,sample.rgb);
    }
    float4 current=direct?Sparse[p]:(total>0?sum/total:Fallback(reflect(direction,float3(0,0,1))));
    if(total<=0){lo=current.rgb;hi=current.rgb;}
    Result[p]=Accumulate(current,world,lo,hi);
}
