// Per-element source decision, evaluated at the Native Composite handoff.
// Pixel provenance: 0 = DX11 raster, 1 = DX12 native.
#ifndef GUIDE_COMPONENTS
#define GUIDE_COMPONENTS 4
#endif
#if GUIDE_COMPONENTS == 1
Texture2D<float> Raster : register(t0);
Texture2D<float> Native : register(t1);
RWTexture2D<float> Selected : register(u0);
#elif GUIDE_COMPONENTS == 2
Texture2D<float2> Raster : register(t0);
Texture2D<float2> Native : register(t1);
RWTexture2D<float2> Selected : register(u0);
#else
Texture2D<float4> Raster : register(t0);
Texture2D<float4> Native : register(t1);
RWTexture2D<float4> Selected : register(u0);
#endif
Texture2D<uint> NativeCoverage : register(t2);
RWTexture2D<uint> SourceOrigin : register(u1);
#include "GuideDecision.hlsli"

cbuffer CompareConstants : register(b0)
{
	uint2 Size;
	float Tolerance;
	uint PriorityMode;  // 0 = native except inside tolerance; 1 = raster except inside tolerance
	uint GuideKind;     // 0 depth, 1 motion, 2 reactive, 3 transparency
	uint HasNative;
	uint HasRaster;
	uint Padding;
	row_major float4x4 InverseProjection;
};

float ViewDistance(float2 clip, float depth)
{
	float4 viewPosition = mul(InverseProjection, float4(clip, depth, 1.0f));
	if (abs(viewPosition.w) <= 1e-8f || !all(isfinite(viewPosition))) return 3.402823e38f;
	return length(viewPosition.xyz / viewPosition.w);
}

[numthreads(8, 8, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
	if (any(id.xy >= Size)) return;
	float4 raster = 0.0f;
	float4 native = 0.0f;
#if GUIDE_COMPONENTS == 1
	if (HasRaster != 0u) raster.x = Raster[id.xy];
#elif GUIDE_COMPONENTS == 2
	if (HasRaster != 0u) raster.xy = Raster[id.xy];
#else
	if (HasRaster != 0u) raster = Raster[id.xy];
#endif
	bool validNative = HasNative != 0u && NativeCoverage[id.xy] != 0u;
#if GUIDE_COMPONENTS == 1
	if (validNative) native.x = Native[id.xy];
#elif GUIDE_COMPONENTS == 2
	if (validNative) native.xy = Native[id.xy];
#else
	if (validNative) native = Native[id.xy];
#endif
	bool withinTolerance = false;
	if (HasRaster != 0u && validNative) {
		float difference;
		if (GuideKind == 0u) {
			float2 clip = (float2(id.xy) + 0.5f) * (2.0f / float2(Size)) - 1.0f;
			clip.y = -clip.y;
			difference = abs(ViewDistance(clip, native.x) - ViewDistance(clip, raster.x));
		} else if (GuideKind == 1u) {
			difference = length((native.xy - raster.xy) * float2(Size));
		} else {
			difference = abs(native.x - raster.x);
		}
		withinTolerance = isfinite(difference) && difference <= Tolerance;
	}
	bool chooseNative = SelectNativeGuide(validNative, HasRaster != 0u, withinTolerance, PriorityMode);
	float4 result = chooseNative ? native : raster;
#if GUIDE_COMPONENTS == 1
	Selected[id.xy] = result.x;
#elif GUIDE_COMPONENTS == 2
	Selected[id.xy] = result.xy;
#else
	Selected[id.xy] = result;
#endif
	SourceOrigin[id.xy] = chooseNative ? 1u : 0u;
}
