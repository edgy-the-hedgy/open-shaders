#include "NativeSurface.hlsli"
#include "FullNativeSampling.hlsli"

ByteAddressBuffer Materials : register(t0);
ByteAddressBuffer Direct : register(t1);
ByteAddressBuffer Indirect : register(t2);
Texture2D<float> Depth : register(t3);
ByteAddressBuffer History : register(t4);
ByteAddressBuffer HistoryMaterials : register(t5);
Texture2D<float> HistoryDepth : register(t6);
ByteAddressBuffer RayIdentity : register(t7);
ByteAddressBuffer HistoryRayIdentity : register(t8);
Texture2D<uint4> RasterIdentity : register(t9);
ByteAddressBuffer RasterDrawTable : register(t10);
#include "NativeRasterDrawIdentity.hlsli"
Texture2D<float2> Motion : register(t11);
Texture2D<uint4> RasterRawDepth : register(t12);
Texture2D<float4> RasterParticipation : register(t13);
RWByteAddressBuffer OwnershipMask : register(u1);
RWByteAddressBuffer Reconstructed : register(u0);
RWByteAddressBuffer EnvironmentRadiance : register(u2);
RWByteAddressBuffer HistorySignals : register(u3);
static const uint NativeHistoryStride = 6u * NativeOpaqueRadianceStride;
cbuffer ReconstructionConstants : register(b0)
{
    uint2 Size;
    uint MaterialPitch;
    uint DirectPitch;
    uint IndirectPitch;
    uint Available;
    uint HistoryMaterialPitch;
    uint HasHistory;
    uint RayIdentityPitch;
    uint HistoryRayIdentityPitch;
    uint HasRasterInput;
    uint RasterWinnerCertified;
    uint CompleteLightingCoverage;
    uint DirectAvailable;
    uint IndirectAvailable;
    uint QualityMode;
    uint FrameIndex;
    uint HasMotion;
    float JitterDeltaX;
    float JitterDeltaY;
    uint HasIndirectHistory;
    uint SameEnvironmentRevision;
};

bool ValidRayIdentity(uint2 identity)
{
    return all(identity != 0xffffffffu);
}

uint2 ReadRayIdentity(uint2 p)
{
    return RayIdentity.Load2(p.y * RayIdentityPitch + p.x * 8u);
}
uint2 SurfaceIdentity(uint2 identity)
{
    return ValidRayIdentity(identity) ? uint2(identity.x, identity.y & 0x7fffffffu) : identity;
}

float4 Unpack(uint2 v)
{
    return f16tof32(uint4(v.x & 65535u, v.x >> 16, v.y & 65535u, v.y >> 16));
}

float4 ReadMaterial(uint2 p, uint offset)
{
    return Unpack(Materials.Load2(p.y * MaterialPitch + p.x * NativeSurfaceStride + offset));
}

static const uint DirectTransmissionSignal = 256u;
static const uint IndirectTransmissionSignal = 512u;
float4 ReadSignal(uint2 p, uint contribution)
{
    // Unwritten sparse pixels can contain an older slot's bytes. Never load them.
    if (!NativeIsSampled(p, Size, QualityMode, FrameIndex)) return 0.0;
    if (contribution == DirectTransmissionSignal)
        return (DirectAvailable & ContributionTransmission) != 0u ? Unpack(Direct.Load2(p.y*DirectPitch+p.x*NativeLightingStride+16u)) : 0.0;
    if (contribution == IndirectTransmissionSignal)
        return (IndirectAvailable & ContributionTransmission) != 0u ? Unpack(Indirect.Load2(p.y*IndirectPitch+p.x*NativeLightingStride+16u)) : 0.0;
    const bool specular = contribution == ContributionDirectSpecular || contribution == ContributionIndirectSpecular;
    const uint offset = specular ? 8u : 0u;
    if ((Available & contribution) == 0u) return 0.0;
    if (contribution == ContributionDirectDiffuse || contribution == ContributionDirectSpecular)
        return Unpack(Direct.Load2(p.y * DirectPitch + p.x * NativeLightingStride + offset));
    return Unpack(Indirect.Load2(p.y * IndirectPitch + p.x * NativeLightingStride + offset));
}

bool ValidSignal(float4 value, uint contribution)
{
    if (!all(isfinite(value)) || value.a <= 0.0) return false;
    // Direct uses a positive diagnostic count; indirect uses explicit contribution bits.
    if (contribution == ContributionDirectDiffuse || contribution == ContributionDirectSpecular) return true;
    if (contribution == DirectTransmissionSignal || contribution == IndirectTransmissionSignal)
        contribution = ContributionTransmission;
    return value.a <= 255.0 && value.a == floor(value.a) && (uint(value.a) & contribution) != 0u;
}

float3 FilterSignal(uint2 pixel, uint contribution, float4 centerBase, float4 centerNormal, float centerDepth, out bool valid, out float3 low, out float3 high)
{
    const bool sampled = NativeIsSampled(pixel, Size, QualityMode, FrameIndex);
    float4 center = ReadSignal(pixel, contribution);
    valid = ValidSignal(center, contribution);
    low = high = valid ? center.rgb : 0.0;
    // A traced but invalid receiver is not an intentionally missing sample.
    if (sampled && !valid) return 0.0;
    uint2 centerIdentity = ReadRayIdentity(pixel);
    if (!ValidRayIdentity(centerIdentity)) return valid ? center.rgb : 0.0;
    if (valid && !ShadowFilterDirectSamples(QualityMode)) return center.rgb;
    float3 sum = valid ? center.rgb : 0.0;
    float weightSum = valid ? 1.0 : 0.0;
    const int radius = int(ShadowReconstructionRadius(QualityMode));
    const int scale = int(ShadowScale(QualityMode));
    int2 logicalCenter = int2(pixel / uint(scale));
    int2 logicalSize = int2(ShadowLogicalExtent(Size.x, QualityMode), ShadowLogicalExtent(Size.y, QualityMode));
    [loop] for (int y = -radius; y <= radius; ++y) {
        [loop] for (int x = -radius; x <= radius; ++x) {
            int2 logical = logicalCenter + int2(x,y);
            if (any(logical < 0) || any(logical >= logicalSize) ||
                ((uint(logical.x) ^ uint(logical.y) ^ FrameIndex) & 1u) != 0u) continue;
            uint2 q = uint2(ShadowRenderCoordinate(uint(logical.x), Size.x, QualityMode),
                ShadowRenderCoordinate(uint(logical.y), Size.y, QualityMode));
            if (all(q == pixel)) continue;
            uint2 neighborIdentity = ReadRayIdentity(q);
            if (!ValidRayIdentity(neighborIdentity) || neighborIdentity.x != centerIdentity.x) continue;
            float4 base = ReadMaterial(q, 0u);
            float4 normal = ReadMaterial(q, 8u);
            float depth = Depth.Load(int3(q, 0));
            if (base.a != centerBase.a || !all(isfinite(base)) || !all(isfinite(normal)) ||
                !isfinite(depth) || abs(depth - centerDepth) > 0.001 ||
                dot(normal.xyz, centerNormal.xyz) < 0.95 || abs(normal.w - centerNormal.w) > 0.1 ||
                any(abs(base.rgb - centerBase.rgb) > 0.15)) continue;
            float4 sample = ReadSignal(q, contribution);
            if (!ValidSignal(sample, contribution)) continue;
            float2 delta = (float2(q) - float2(pixel)) / float(scale);
            float weight = rcp(1.0 + dot(delta, delta));
            low = weightSum > 0.0 ? min(low, sample.rgb) : sample.rgb;
            high = weightSum > 0.0 ? max(high, sample.rgb) : sample.rgb;
            sum += weight * sample.rgb;
            weightSum += weight;
        }
    }
    valid = weightSum > 0.0;
    return valid ? sum / weightSum : 0.0;
}

// Engine motion is previous minus current unjittered UV. Add the actual
// previous-minus-current raster jitter in pixels exactly once.
bool HistorySurfaceMatches(uint2 p, float4 base, float4 normal, float depth, out uint2 oldPixel)
{
    oldPixel = p;
    if (HasHistory == 0u) return false;
    float2 velocity = HasMotion != 0u ? Motion.Load(int3(p,0)) : 0.0;
    if (!all(isfinite(velocity)) || any(abs(velocity) > 1.0)) return false;
    float2 oldPosition = float2(p) + 0.5 + velocity * float2(Size) + float2(JitterDeltaX, JitterDeltaY);
    if (any(oldPosition < 0.0) || any(oldPosition >= float2(Size))) return false;
    oldPixel = uint2(oldPosition);
    uint2 currentIdentity = ReadRayIdentity(p);
    uint2 previousIdentity = HistoryRayIdentity.Load2(oldPixel.y * HistoryRayIdentityPitch + oldPixel.x * 8u);
    if (!ValidRayIdentity(currentIdentity) || !ValidRayIdentity(previousIdentity) || any(SurfaceIdentity(currentIdentity) != SurfaceIdentity(previousIdentity))) return false;
    uint offset = oldPixel.y * HistoryMaterialPitch + oldPixel.x * NativeSurfaceStride;
    float4 oldBase = Unpack(HistoryMaterials.Load2(offset));
    float4 oldNormal = Unpack(HistoryMaterials.Load2(offset + 8u));
    float oldDepth = HistoryDepth.Load(int3(oldPixel, 0));
    return oldBase.a == base.a && all(isfinite(oldBase)) && all(isfinite(oldNormal)) &&
        isfinite(oldDepth) && abs(depth - oldDepth) <= 0.00001 &&
        dot(normal.xyz, oldNormal.xyz) >= 0.995 && abs(normal.w - oldNormal.w) <= 0.02 &&
        all(abs(base.rgb - oldBase.rgb) <= 0.02);
}

float3 AccumulateStationary(float3 current, uint valid, uint offset, float3 low, float3 high)
{
    if (valid == 0u) return current;
    float4 previous = Unpack(History.Load2(offset));
    if (!all(isfinite(previous)) || previous.a != float(valid)) return current;
    // Limit reuse on lighting changes rather than carrying stale highlights.
    float3 bound = max(abs(current) * 0.25, 0.002);
    if (ShadowClampHistory(QualityMode)) previous.rgb = clamp(previous.rgb, low, high);
    else if (any(abs(previous.rgb - current) > bound)) return current;
    return lerp(previous.rgb, current, rcp(float(ShadowTemporalFrames(QualityMode))));
}

[numthreads(8, 8, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= Size)) return;
    const uint offset = (id.y * Size.x + id.x) * NativeLightingStride;
    Reconstructed.Store4(offset, uint4(0, 0, 0, 0));
    Reconstructed.Store2(offset+16u,uint2(0,0));
    const uint ownershipOffset = (id.y * Size.x + id.x) * 4u;
    uint ownership = 0u;
    OwnershipMask.Store(ownershipOffset, 0u);
    const uint radianceOffset = (id.y * Size.x + id.x) * 8u;
    EnvironmentRadiance.Store2(radianceOffset, uint2(0,0));
    const uint historyOffset = (id.y * Size.x + id.x) * NativeHistoryStride;
    [unroll] for (uint signal = 0u; signal < 6u; ++signal)
        HistorySignals.Store2(historyOffset + signal * NativeOpaqueRadianceStride, uint2(0,0));
    if (HasRasterInput != 0u) {
        uint2 encoded = RasterIdentity.Load(int3(id.xy, 0)).xy;
        float rawDepth = asfloat(RasterRawDepth.Load(int3(id.xy,0)).w);
        float finalDepth = Depth.Load(int3(id.xy,0));
        uint drawAddress;
        uint2 raster;
        if (RasterWinnerCertified != 0u && DecodeRasterDraw(RasterDrawTable,HasRasterInput,encoded,drawAddress,raster) &&
            all(raster!=0xffffffffu) && RasterParticipation.Load(int3(id.xy,0)).z == 1.0 &&
            isfinite(rawDepth) && isfinite(finalDepth) && abs(rawDepth-finalDepth) <= 1e-6) {
            uint2 hit = ReadRayIdentity(id.xy);
            if (ValidRayIdentity(hit) && all(raster == SurfaceIdentity(hit))) {
                ownership |= RasterIdentityCandidate;
                if (RasterWinnerCertified != 0u && (hit.y & 0x80000000u) == 0u) ownership |= ExactRasterWinner;
            }
        }
    }
    OwnershipMask.Store(ownershipOffset, ownership);
    const float4 base = ReadMaterial(id.xy, 0u);
    const float4 normal = ReadMaterial(id.xy, 8u);
    const float depth = Depth.Load(int3(id.xy, 0));
    if (!HasEvaluatedNativeBase(base.a) || !all(isfinite(base)) || !all(isfinite(normal)) ||
        !isfinite(depth) || depth <= 0.0 || depth >= 1.0 || dot(normal.xyz, normal.xyz) < 1e-8) return;
    bool dd, ds, idiff, ispec, dt, it;
    float3 ddLow, ddHigh, dsLow, dsHigh, idLow, idHigh, isLow, isHigh, dtLow, dtHigh, itLow, itHigh;
    float3 directDiffuse = FilterSignal(id.xy, ContributionDirectDiffuse, base, normal, depth, dd, ddLow, ddHigh);
    float3 directSpecular = FilterSignal(id.xy, ContributionDirectSpecular, base, normal, depth, ds, dsLow, dsHigh);
    float3 indirectDiffuse = FilterSignal(id.xy, ContributionIndirectDiffuse, base, normal, depth, idiff, idLow, idHigh);
    float3 indirectSpecular = FilterSignal(id.xy, ContributionIndirectSpecular, base, normal, depth, ispec, isLow, isHigh);
    float3 directTransmission = FilterSignal(id.xy, DirectTransmissionSignal, base, normal, depth, dt, dtLow, dtHigh);
    float3 indirectTransmission = FilterSignal(id.xy, IndirectTransmissionSignal, base, normal, depth, it, itLow, itHigh);
    uint2 oldPixel;
    if (HistorySurfaceMatches(id.xy, base, normal, depth, oldPixel)) {
        const uint oldOffset = (oldPixel.y * Size.x + oldPixel.x) * NativeHistoryStride;
        directDiffuse = AccumulateStationary(directDiffuse, dd ? ContributionDirectDiffuse : 0u, oldOffset, ddLow, ddHigh);
        directSpecular = AccumulateStationary(directSpecular, ds ? ContributionDirectSpecular : 0u, oldOffset + 8u, dsLow, dsHigh);
        directTransmission = AccumulateStationary(directTransmission, dt ? ContributionTransmission : 0u, oldOffset + 16u, dtLow, dtHigh);
        // A new source generation can change all three signals (including
        // disappearance of the independently acquired sky). Reject old
        // indirect samples; direct history remains independently eligible.
        if (HasIndirectHistory != 0u && SameEnvironmentRevision != 0u) {
            indirectDiffuse = AccumulateStationary(indirectDiffuse, idiff ? ContributionIndirectDiffuse : 0u, oldOffset + 24u, idLow, idHigh);
            indirectSpecular = AccumulateStationary(indirectSpecular, ispec ? ContributionIndirectSpecular : 0u, oldOffset + 32u, isLow, isHigh);
            indirectTransmission = AccumulateStationary(indirectTransmission, it ? ContributionTransmission : 0u, oldOffset + 40u, itLow, itHigh);
        }
    }
    HistorySignals.Store2(historyOffset, PackOpaqueRadiance(directDiffuse, dd ? ContributionDirectDiffuse : 0u));
    HistorySignals.Store2(historyOffset + 8u, PackOpaqueRadiance(directSpecular, ds ? ContributionDirectSpecular : 0u));
    HistorySignals.Store2(historyOffset + 16u, PackOpaqueRadiance(directTransmission, dt ? ContributionTransmission : 0u));
    HistorySignals.Store2(historyOffset + 24u, PackOpaqueRadiance(indirectDiffuse, idiff ? ContributionIndirectDiffuse : 0u));
    HistorySignals.Store2(historyOffset + 32u, PackOpaqueRadiance(indirectSpecular, ispec ? ContributionIndirectSpecular : 0u));
    HistorySignals.Store2(historyOffset + 40u, PackOpaqueRadiance(indirectTransmission, it ? ContributionTransmission : 0u));
    // The environment input contains only direct reconstructed light and emission.
    if (dd && dt && base.a == SurfaceEvaluatedBase && (ownership & RasterIdentityCandidate) != 0u) {
        float3 emission = ReadMaterial(id.xy, 24u).rgb;
        float3 radiance = max(directDiffuse + directTransmission + max(emission, 0.0), 0.0);
        if (all(isfinite(emission)) && all(isfinite(radiance)) && all(radiance <= 65504.0))
            EnvironmentRadiance.Store2(radianceOffset, PackOpaqueRadiance(radiance, ContributionDirectDiffuse));
    }
    const float3 transmission = directTransmission + indirectTransmission;
    const uint transmissionValid = dt && it ? ContributionTransmission : 0u;
    const uint diffuseValid = (dd ? ContributionDirectDiffuse : 0u) | (idiff ? ContributionIndirectDiffuse : 0u);
    const uint specularValid = (ds ? ContributionDirectSpecular : 0u) | (ispec ? ContributionIndirectSpecular : 0u);
    const float3 diffuse = directDiffuse + indirectDiffuse;
    const float3 specular = directSpecular + indirectSpecular;
    const uint2 packedDiffuse = PackOpaqueRadiance(diffuse, diffuseValid);
    const uint2 packedSpecular = PackOpaqueRadiance(specular, specularValid);
    const uint2 packedTransmission=PackOpaqueRadiance(transmission,transmissionValid);
    Reconstructed.Store4(offset, uint4(packedDiffuse, packedSpecular));
    Reconstructed.Store2(offset+16u,packedTransmission);
    // Check the actual encoded output, not the pre-pack validity flags. Half
    // overflow can invalidate the signal. Zero radiance still needs valid bits.
    uint valid = uint(Unpack(packedDiffuse).a) | uint(Unpack(packedSpecular).a) | uint(Unpack(packedTransmission).a);
    // Transmission requires independently valid direct AND indirect signals.
    // Emissive radiance is read and applied separately by CompositeFullNative.
    if (base.a == SurfaceEvaluatedBase && ValidRayIdentity(ReadRayIdentity(id.xy))) {
        const float4 emissionAO = ReadMaterial(id.xy, 24u);
        if ((Available & ContributionEmission) != 0u && all(isfinite(emissionAO.rgb)))
            valid |= ContributionEmission;
    }
    const bool complete = CompleteLightingCoverage != 0u && (Available & ~255u) == 0u &&
        (valid & ~Available) == 0u && (valid & NativeOpaqueRequired) == NativeOpaqueRequired;
    if (complete) ownership |= CompleteOpaqueRadiance;
    if (complete && base.a == SurfaceEvaluatedBase && (ownership & ExactRasterWinner) != 0u)
        ownership |= NativeOwnsOpaque;
    OwnershipMask.Store(ownershipOffset, ownership);
}
