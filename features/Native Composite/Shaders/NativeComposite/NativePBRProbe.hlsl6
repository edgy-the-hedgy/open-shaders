// Representative opaque triangle material evaluation, not a screen renderer.
// Layout matches GpuMaterialAbi.h and DX12NativeAcceleration.h.
#define NATIVE_GEOMETRY_REGISTER t0
#define NATIVE_RECORD_REGISTER t1
#define NATIVE_BINDING_REGISTER t2
#define NATIVE_TEXTURE_REGISTER t3
#include "NativeMaterialAlpha.hlsli"
#include "NativeSurface.hlsli"
#include "NativeRawRasterInput.hlsli"
#include "FullNativeSampling.hlsli"
#define NATIVE_MATERIAL_PROJECTION
#include "NativeMaterialSurface.hlsli"
#undef NATIVE_MATERIAL_PROJECTION
RWStructuredBuffer<Sample> Output : register(u0);
cbuffer Constants : register(b0) { uint InstanceCount; };

[numthreads(64,1,1)]
void main(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= InstanceCount) return;
    NativeCoatSample coat;
    const float3x3 identity=float3x3(1,0,0,0,1,0,0,0,1);
    NativeParallaxShadowSample shadow;
    bool rawUsed;
    Output[id.x] = EvaluateMaterial(InstanceCount,id.x, 0u, float3(1.0/3.0,1.0/3.0,1.0/3.0), float3(0,0,-1), float3(0,0,0), float3(0,0,0), 1.0, 0.0, identity, identity, false, false, false, 0.0, 0xffffffffu, 0.0, 0.0, (RawRasterSurface)0, rawUsed, coat, shadow);
}

Texture2D<float> ProbeDepth : register(t515);
RaytracingAccelerationStructure ProbeScene : register(t516);
ByteAddressBuffer ProbeInstanceTransforms : register(t1037);
StructuredBuffer<MaterialRecord> RasterMaterialRecords : register(t1038);
StructuredBuffer<Binding> RasterMaterialBindings : register(t1039);
ByteAddressBuffer RasterLandscapeRows : register(t1040);
ByteAddressBuffer RasterMaterialLookup : register(t1041);
ByteAddressBuffer RasterProjectionLookup : register(t1042);
cbuffer ProbeCamera : register(b1)
{
    row_major float4x4 InverseProjection;
    row_major float4x4 InverseView;
    float4 PositionAdjust;
    uint2 ViewSize;
    uint2 GridSize;
    uint CollectStats;
    uint ParallaxEnabled;
    uint ParallaxWarpFixEnabled;
    uint ParallaxShadowEnabled;
    float MaterialMipBias;
    uint ProjectionRowCount;
    uint ProjectionFrame;
    uint HasRawInput;
    uint QualityMode;
    uint TransformCount;
    uint RasterBindingCount;
    uint RasterRecordCount;
    uint SceneRecordCount;
    uint RasterSourceCount;
    uint HasSecondaryScene;
    uint HasRasterRayMapping;
    uint RasterPreparedSourceCount;
    uint DiagnosticRayProbe;
};
RWByteAddressBuffer ProbeCounts : register(u1);
RWByteAddressBuffer ScreenOutput : register(u2);
// Separate identity plane: material ABI remains 32 bytes per sample.
RWByteAddressBuffer RayIdentity : register(u3);
RWByteAddressBuffer MaterialLobes : register(u4);
uint2 PackHalf4(float4 value)
{
    uint4 bits=f32tof16(clamp(value,-65504.0,65504.0));
    return uint2(bits.x | (bits.y<<16),bits.z | (bits.w<<16));
}
groupshared uint GroupCounts[12];

// Non-opaque instances are marked in the TLAS; do not commit a candidate
// without a resident alpha texture and an authoritative comparison function.

float3 ProbeRayOffset(float2 clip, float z, float3 centerWorld)
{
    float4 v=mul(InverseProjection,float4(clip,z,1));
    if (!all(isfinite(v)) || abs(v.w)<1e-8) return 0.0;
    float4 w=mul(InverseView,float4(v.xyz/v.w,1));
    if (!all(isfinite(w)) || abs(w.w)<1e-8) return 0.0;
    return w.xyz/w.w-centerWorld;
}
// Intersect only the raster-indicated primitive in its local space. This is
// not a scene traversal and cannot establish that it was the closest TLAS hit.
// A separate identity bit preserves that distinction through reconstruction.
bool IntersectRasterCandidate(uint2 identity, float3 origin, float3 direction, float distance, float tolerance,
    out float2 bary, out float hitDistance, out float3x3 worldToObject, out float3x3 objectToWorld)
{
    bary=0; hitDistance=0; worldToObject=(float3x3)0; objectToWorld=(float3x3)0;
    if (identity.x >= InstanceCount || identity.x >= TransformCount) return false;
    uint4 offsets=Geometry.Load4(identity.x*32u), counts=Geometry.Load4(identity.x*32u+16u);
    if (offsets.x==0xffffffffu || offsets.y==0xffffffffu || counts.z<12u ||
        identity.y>=counts.y/3u) return false;
    uint3 ix=Geometry.Load3(offsets.y+identity.y*12u);
    if (any(ix>=counts.x)) return false;
    uint transform=identity.x*48u;
    float4 r0=asfloat(ProbeInstanceTransforms.Load4(transform));
    float4 r1=asfloat(ProbeInstanceTransforms.Load4(transform+16u));
    float4 r2=asfloat(ProbeInstanceTransforms.Load4(transform+32u));
    float determinant=dot(r0.xyz,cross(r1.xyz,r2.xyz));
    if (!isfinite(determinant) || abs(determinant)<1e-12) return false;
    objectToWorld=float3x3(r0.xyz,r1.xyz,r2.xyz);
    worldToObject=transpose(float3x3(cross(r1.xyz,r2.xyz),cross(r2.xyz,r0.xyz),cross(r0.xyz,r1.xyz)))/determinant;
    float3 rayOrigin=mul(worldToObject,origin-float3(r0.w,r1.w,r2.w));
    float3 rayDirection=mul(worldToObject,direction);
    float3 p0=asfloat(Geometry.Load3(offsets.x+ix.x*counts.z));
    float3 e1=asfloat(Geometry.Load3(offsets.x+ix.y*counts.z))-p0;
    float3 e2=asfloat(Geometry.Load3(offsets.x+ix.z*counts.z))-p0;
    float3 p=cross(rayDirection,e2);
    float det=dot(e1,p);
    if (!isfinite(det) || abs(det)<1e-12) return false;
    float3 t=rayOrigin-p0;
    float3 q=cross(t,e1);
    bary=float2(dot(t,p),dot(rayDirection,q))/det;
    hitDistance=dot(e2,q)/det;
    return all(isfinite(bary)) && isfinite(hitDistance) &&
        all(bary>=-0.0001) && bary.x+bary.y<=1.0001 &&
        hitDistance>0.5 && abs(hitDistance-distance)<=tolerance;
}

// Six authored base layers and up to two borrowed seam layers. LOD/snow
// deformation and advanced terrain lobes remain explicitly feature-limited.
Sample EvaluateRasterLandscape(RawRasterSurface raw, float3 viewRay, float distance,
    out bool rawUsed, out NativeCoatSample coat, out NativeParallaxShadowSample shadow)
{
    rawUsed=false; coat=(NativeCoatSample)0; shadow=(NativeParallaxShadowSample)0;
    Sample result=(Sample)0; result.color.a=SurfaceUnsupportedMaterial;
    uint address=(raw.materialOrdinal-1u)*48u;
    uint4 row0=RasterLandscapeRows.Load4(address),row1=RasterLandscapeRows.Load4(address+16u);
    if (RasterLandscapeRows.Load(address+32u)!=6u) return result;
    float weights[8];
    float2 w0=f16tof32(uint2(raw.auxiliary.x&65535u,raw.auxiliary.x>>16u));
    float2 w1=f16tof32(uint2(raw.auxiliary.y&65535u,raw.auxiliary.y>>16u));
    float2 w2=f16tof32(uint2(raw.auxiliary.z&65535u,raw.auxiliary.z>>16u));
    if (!all(isfinite(float4(w0,w1))) || !all(isfinite(w2))) return result;
    weights[0]=max(w0.x,0.0); weights[1]=max(w0.y,0.0);
    weights[2]=max(w1.x,0.0); weights[3]=max(w1.y,0.0);
    weights[4]=max(w2.x,0.0); weights[5]=max(w2.y,0.0);
    float2 w3=raw.borrowedLandscape ? f16tof32(uint2(raw.auxiliary.w&65535u,raw.auxiliary.w>>16u)) : float2(0,0);
    if (!all(isfinite(w3))) return result;
    weights[6]=max(w3.x,0.0); weights[7]=max(w3.y,0.0);
    float total=dot(max(float4(w0,w1),0.0),1.0)+dot(max(float4(w2,w3),0.0),1.0);
    if (total<=1e-6 || !isfinite(total)) return result;
    NativeMaterialTriangle tri=(NativeMaterialTriangle)0;
    tri.rasterLocal=true; tri.hasTangents=true;
    tri.normals[0]=raw.normal; tri.tangents[0]=raw.tangent; tri.bitangents[0]=raw.bitangent;
    tri.colors[0]=raw.color; tri.uv[0]=raw.uv;
    raw.auxiliaryKind=0u;
    const float3x3 identity=float3x3(1,0,0,0,1,0,0,0,1);
    Sample blended=(Sample)0;
    float used=0.0;
    [unroll] for (uint layer=0u; layer<8u; ++layer) {
        float weight=weights[layer]/total;
        // Do not drop small authored or borrowed terrain weights.
        if (weight<=1e-6) continue;
        uint bindingIndex=layer<4u ? row0[layer] : row1[layer-4u];
        if (bindingIndex>=RasterBindingCount) { result.color.a=SurfaceMissingTextures; return result; }
        Binding binding=RasterMaterialBindings[bindingIndex];
        if (binding.materialIndex>=RasterRecordCount) { result.color.a=SurfaceMissingTextures; return result; }
        MaterialRecord material=RasterMaterialRecords[binding.materialIndex];
        NativeCoatSample unusedCoat; NativeParallaxShadowSample unusedShadow; bool sampled;
        Sample surface=EvaluateMaterialTriangle(binding,material,tri,0u,float3(1,0,0),viewRay,0,0,1.0,distance,
            identity,identity,false,false,false,MaterialMipBias,0xffffffffu,0.0,0.0,raw,sampled,unusedCoat,unusedShadow);
        if (!sampled || !HasEvaluatedNativeBase(surface.color.a)) {
            result.color.a=SurfaceEvaluationFailed; return result;
        }
        blended.color.rgb+=surface.color.rgb*weight;
        blended.normal+=surface.normal*weight;
        blended.f0+=surface.f0*weight;
        blended.emission+=surface.emission*weight;
        used+=weight;
    }
    if (used<=1e-6 || dot(blended.normal.xyz,blended.normal.xyz)<=1e-8) return result;
    blended.color.rgb/=used;
    blended.normal=float4(normalize(blended.normal.xyz),clamp(blended.normal.w/used,0.045,1.0));
    blended.f0/=used; blended.emission/=used;
    blended.color.a=SurfaceFeatureLimited;
    rawUsed=true;
    return blended;
}

// PBR grass uses the original draw-local b1 snapshot and six typed SRVs.
// This route never treats PBR textures as a legacy complex grass atlas.
Sample EvaluatePbrGrass(RawRasterSurface raw,float3 viewRay,out bool rawUsed,out NativeCoatSample coat)
{
    Sample result=(Sample)0;
    rawUsed=false; coat=(NativeCoatSample)0;
    result.color.a=SurfaceMissingTextures;
    if (ProjectionRowCount==0u || raw.drawIdentity.x==0u ||
        raw.drawIdentity.x>(HasRawInput&0x7fffffffu)) return result;
    uint row=RasterProjectionLookup.Load((raw.drawIdentity.x-1u)*4u);
    if (row>=ProjectionRowCount) return result;
    uint4 meta=ProjectionRecords.Load(int3(0,row,0));
    if (meta.x!=0xfffffffau || meta.z!=row) return result;
    uint4 first=ProjectionRecords.Load(int3(1,row,0));
    uint flags=first.x;
    if (flags!=(raw.auxiliary.x&65535u)) return result;
    float3 p1=asfloat(first.yzw);
    float4 p2=asfloat(ProjectionRecords.Load(int3(2,row,0)));
    float4 p3=asfloat(ProjectionRecords.Load(int3(3,row,0)));
    float4 p4=asfloat(ProjectionRecords.Load(int3(4,row,0)));
    float fuzzRoughness=asfloat(ProjectionRecords.Load(int3(5,row,0)).x);
    uint4 extra=ProjectionRecords.Load(int3(6,row,0));
    uint4 tex=ProjectionRecords.Load(int3(7,row,0));
    if (!all(isfinite(p1)) || !all(isfinite(p2)) || !all(isfinite(p3)) ||
        !all(isfinite(p4)) || !isfinite(fuzzRoughness) || tex.x>=NativeProjectionTextureCapacity) return result;
    bool detail=(raw.auxiliary.x&(1u<<16u))!=0u;
    bool newModel=(raw.auxiliary.x&(1u<<17u))!=0u;
    bool sphere=(raw.auxiliary.x&(1u<<18u))!=0u;
    float bias=exp2(clamp(MaterialMipBias,-8.0,8.0));
    float2 dx=raw.dx*bias,dy=raw.dy*bias,uv=raw.uv;
    float4 diffuse=NativeProjectionGrad(tex.x,meta.w&3u,uv,dx,dy);
    // TruePBR color maps are authored linear.
    float3 base=(meta.w&256u)!=0u ? NativeProjectionEncode(diffuse.rgb) : diffuse.rgb;
    float3 vc=(raw.auxiliary.x&(1u<<19u))!=0u ? 1.0 : raw.color.rgb;
    float vertexAO=max(vc.r,max(vc.g,vc.b));
    float2 settings=RawHalf2(raw.auxiliary.w);
    base=max(base,0.0)*SrgbToLinear(vc/max(vertexAO,1e-5))*max(settings.x,0.0);
    float3 n=RawOct(raw.auxiliary.y);
    float4 rmaos=float4(1,0,1,0);
    if (detail) {
        if (tex.y>=NativeProjectionTextureCapacity || tex.z>=NativeProjectionTextureCapacity) return result;
        float3 mapped=NativeProjectionGrad(tex.y,(meta.w>>2u)&3u,uv,dx,dy).xyz*2.0-1.0;
        float3 t=raw.tangent-n*dot(raw.tangent,n);
        if (dot(t,t)>1e-8 && dot(mapped,mapped)>1e-8) {
            t=normalize(t);
            float3 b=normalize(cross(n,t));
            if (dot(b,raw.bitangent)<0.0) b=-b;
            n=normalize(t*mapped.x+b*mapped.y+n*mapped.z);
        }
        rmaos=NativeProjectionGrad(tex.z,(meta.w>>4u)&3u,uv,dx,dy)*float4(p1.x,1,1,p1.y);
    }
    if (newModel && !sphere) {
        float3 clump=RawOct(raw.auxiliary.z);
        n=normalize(n+(clump-n*dot(n,clump))*saturate(settings.y));
    }
    float metallic=saturate(rmaos.y);
    float3 f0=lerp(saturate(rmaos.w).xxx,base,metallic);
    float roughness=clamp(rmaos.x*((raw.front || !newModel)?1.0:max(p4.w,0.0)),0.045,1.0);
    if (newModel && (flags&(1u<<4u))!=0u) {
        float3 scatter=max(p2.rgb,0.0);
        float opacity=saturate(p2.a);
        if (detail && (flags&(1u<<2u))!=0u) {
            if (tex.w>=NativeProjectionTextureCapacity) return result;
            float4 sample=NativeProjectionGrad(tex.w,(meta.w>>6u)&3u,uv,dx,dy);
            scatter*=((meta.w&2048u)!=0u ? NativeProjectionEncode(sample.rgb) : sample.rgb);
            opacity*=saturate(sample.a);
        } else scatter*=base*(1.0-metallic);
        float3 face=normalize(raw.normal);
        if (dot(face,viewRay)>0.0) face=-face;
        coat.normalRoughness=float4(face,saturate(p4.x));
        coat.f0Colored=float4(saturate(raw.front?p4.y:p4.z),saturate(p4.z),max(p4.w,0.0),NativeFoliageTag);
        coat.subsurface=float4(scatter,opacity);
    }
    if (newModel && detail && (flags&(1u<<9u))!=0u) {
        float3 fuzz=max(p3.rgb,0.0); float weight=saturate(p3.a);
        if ((flags&(1u<<3u))!=0u) {
            if (extra.x>=NativeProjectionTextureCapacity) { coat=(NativeCoatSample)0; return result; }
            float4 sample=NativeProjectionGrad(extra.x,extra.z&3u,uv,dx,dy);
            fuzz*=((extra.z&256u)!=0u ? NativeProjectionEncode(sample.rgb) : sample.rgb);
            weight*=saturate(sample.a);
        }
        if (HasNativeThinSurface(coat)) coat.f0Colored.w=EncodeNativeThinFuzz(fuzzRoughness,true);
        else { coat.normalRoughness.w=clamp(fuzzRoughness,-1.0,1.0); coat.f0Colored.w=NativeFuzzTag; }
        coat.colorStrength=float4(saturate(fuzz),weight);
    }
    float3 emission=0.0;
    if (newModel && (flags&1u)!=0u) {
        if (extra.y>=NativeProjectionTextureCapacity) { coat=(NativeCoatSample)0; return result; }
        emission=NativeProjectionGrad(extra.y,(extra.z>>2u)&3u,uv,dx,dy).rgb*max(p1.z,0.0)*SrgbToLinear(vc);
    }
    if (!all(isfinite(base)) || !all(isfinite(n)) || !all(isfinite(f0)) ||
        !all(isfinite(emission)) || !isfinite(roughness) || !all(isfinite(rmaos))) {
        coat=(NativeCoatSample)0; result.color.a=SurfaceEvaluationFailed; return result;
    }
    result.color=float4(base,SurfaceFeatureLimited);
    result.normal=float4(normalize(n),roughness);
    result.f0=float4(f0,metallic);
    result.emission=float4(max(emission,0.0),saturate(rmaos.z*vertexAO));
    rawUsed=true;
    return result;
}

// Shader-class-specific base evaluation using typed draw-local SRV transfers.
// Row tags cannot be mistaken for a scene instance or a Lighting recipe.
// No ray correspondence or TXST material ordinal is required.
Sample EvaluateNonLightingRaster(RawRasterSurface raw, float3 viewRay, out bool rawUsed, out NativeCoatSample coat)
{
    Sample result=(Sample)0;
    rawUsed=false;
    coat=(NativeCoatSample)0;
    result.color.a=SurfaceUnsupportedMaterial;
    const uint kind=raw.auxiliaryKind;
    const uint expected=kind==5u ? 0xfffffffeu : kind==6u ? 0xfffffffdu : 0xfffffffcu;
    // Complex Effect techniques do not yet have a complete material evaluator.
    if (kind==7u && (raw.auxiliary.y&1u)==0u) return result;
    result.color.a=SurfaceMissingTextures;
    if (ProjectionRowCount==0u || raw.drawIdentity.x==0u ||
        raw.drawIdentity.x>(HasRawInput & 0x7fffffffu)) return result;
    uint row=RasterProjectionLookup.Load((raw.drawIdentity.x-1u)*4u);
    if (row>=ProjectionRowCount) return result;
    uint4 metadata=ProjectionRecords.Load(int3(0,row,0));
    if (metadata.x!=expected || metadata.z!=row) return result;
    uint4 textures=ProjectionRecords.Load(int3(7,row,0));
    const bool sampledBase=kind!=7u || (raw.auxiliary.y&2u)!=0u;
    if (sampledBase && textures.x>=NativeProjectionTextureCapacity) return result;
    float gradientScale=exp2(clamp(MaterialMipBias,-16.0,16.0));
    float2 uv=raw.uv, dx=raw.dx*gradientScale, dy=raw.dy*gradientScale;
    bool complexGrass=kind==5u && (raw.auxiliary.x&1u)!=0u;
    if (complexGrass) { uv.y*=0.5; dx.y*=0.5; dy.y*=0.5; }
    float4 texel=1.0;
    if (sampledBase) texel=NativeProjectionGrad(textures.x,metadata.w&3u,uv,dx,dy);
    float3 encoded=(metadata.w&256u)!=0u ? NativeProjectionEncode(texel.rgb) : texel.rgb;
    float3 base=SrgbToLinear(encoded);
    float3 normal=normalize(raw.normal);
    float roughness=1.0;
    float3 f0=0.0;
    float ao=1.0;
    float3 emission=0.0;
    if (kind==5u) {
        float2 settings=RawHalf2(raw.auxiliary.z);
        float2 spec=RawHalf2(raw.auxiliary.w);
        normal=RawOct(raw.auxiliary.y);
        if (dot(normal,viewRay)>0.0) normal=-normal;
        roughness=clamp(settings.x,0.045,1.0);
        base*=SrgbToLinear(raw.color.rgb)*max(settings.y,0.0);
        ao=saturate(max(raw.color.r,max(raw.color.g,raw.color.b)));
        if (complexGrass && (raw.auxiliary.x&2u)!=0u) {
            // The lower half of a legacy complex grass atlas contains normal
            // and specular data, not a second diffuse texture.
            float4 detail=NativeProjectionGrad(textures.x,metadata.w&3u,uv+float2(0.0,0.5),dx,dy);
            float3 packed=(metadata.w&256u)!=0u ? NativeProjectionEncode(detail.rgb) : detail.rgb;
            float3 mapped=packed*2.0-1.0;
            float3 tangent=raw.tangent-normal*dot(raw.tangent,normal);
            if (dot(tangent,tangent)>1e-8 && dot(mapped,mapped)>1e-8) {
                tangent=normalize(tangent);
                float3 bitangent=normalize(cross(normal,tangent));
                if (dot(bitangent,raw.bitangent)<0.0) bitangent=-bitangent;
                normal=normalize(tangent*mapped.x+bitangent*mapped.y+normal*mapped.z);
            }
            f0=saturate(detail.a*max(spec.x,0.0)).xxx;
        }
        // Publish the legacy grass thin-sheet model independently of its
        // still feature-limited base. The geometric face is the bias normal.
        float balance=f16tof32(raw.auxiliary.x>>16u);
        if (isfinite(spec.y) && spec.y>0.0 && isfinite(balance) && all(isfinite(base))) {
            float3 face=normalize(raw.normal);
            if (dot(face,viewRay)>0.0) face=-face;
            coat.normalRoughness=float4(face,saturate(balance));
            coat.f0Colored=float4(1.0,1.0,1.0,NativeFoliageTag);
            coat.subsurface=float4(max(base,0.0),1.0-0.5*saturate(spec.y));
        }
    } else if (kind==7u) {
        float4 tint=asfloat(ProjectionRecords.Load(int3(1,row,0)));
        float scale=asfloat(metadata.y);
        if (!all(isfinite(tint)) || !isfinite(scale)) return result;
        float2 liveRG=RawHalf2(raw.auxiliary.z);
        float2 liveBScale=RawHalf2(raw.auxiliary.w);
        float3 tintRgb=float3(liveRG,liveBScale.x);
        if (!all(isfinite(tintRgb)) || !isfinite(liveBScale.y)) return result;
        float3 effectGamma=texel.rgb*tintRgb;
        if ((raw.pixelDescriptor&(1u<<19u))!=0u) {
            if (textures.y>=NativeProjectionTextureCapacity) return result;
            // Palette addressing follows the original Effect shader.
            // Original Effect samples the typed view directly, including
            // hardware sRGB decoding if present. No re-encoding.
            float2 paletteUV=float2(texel.g,tintRgb.r);
            float4 palette=NativeProjectionGrad(textures.y,(metadata.w>>2u)&3u,paletteUV,0.0,0.0);
            effectGamma=palette.rgb*liveBScale.y;
        }
        // Effect uses Skyrim scene gamma (1.6), not authored sRGB.
        // The native material domain is linear Rec.709, before final gamut conversion.
        base=sign(effectGamma)*pow(abs(effectGamma),1.6);
        float saturation=f16tof32(raw.auxiliary.y>>16u);
        if (!isfinite(saturation)) return result;
        base=lerp(dot(base,float3(0.2125,0.7154,0.0721)).xxx,base,saturate(saturation));
        float influence=asfloat(raw.auxiliary.x);
        if (!isfinite(influence) || influence<0.0 || influence>1.0) return result;
        emission=base*(1.0-influence);
        base*=influence;
    }
    if (!all(isfinite(base)) || !all(isfinite(normal)) || dot(normal,normal)<1e-8 ||
        !all(isfinite(f0)) || !all(isfinite(emission)) || !isfinite(roughness) || !isfinite(ao)) {
        coat=(NativeCoatSample)0;
        result.color.a=SurfaceEvaluationFailed; return result;
    }
    // Base properties are genuinely evaluated; unsupported lobe, snow,
    // lighting-model and special Effect behavior remains feature-limited.
    result.color=float4(base,SurfaceFeatureLimited);
    result.normal=float4(normalize(normal),roughness);
    result.f0=float4(f0,0.0);
    result.emission=float4(emission,ao);
    rawUsed=true;
    return result;
}

// Direct evaluation of certified raster interpolants, independent of TLAS mapping.
Sample EvaluateRasterLocal(RawRasterSurface raw, uint2 mapped, float3 viewRay, float distance,
    float3 worldPosition, float3 worldDx, float3 worldDy, float noise,
    out bool rawUsed, out NativeCoatSample coat, out NativeParallaxShadowSample shadow)
{
    rawUsed=false; coat=(NativeCoatSample)0; shadow=(NativeParallaxShadowSample)0;
    Sample result=(Sample)0; result.color.a=SurfaceUnsupportedMaterial;
    if (raw.auxiliaryKind==10u) return EvaluatePbrGrass(raw,viewRay,rawUsed,coat);
    if (raw.auxiliaryKind>=5u && raw.auxiliaryKind<=7u)
        return EvaluateNonLightingRaster(raw,viewRay,rawUsed,coat);
    if (raw.materialOrdinal==0u || raw.materialOrdinal>RasterSourceCount) return result;
    uint preparedRow=RasterMaterialLookup.Load((raw.materialOrdinal-1u)*4u);
    if (preparedRow>=RasterPreparedSourceCount) { result.color.a=SurfaceMissingTextures; return result; }
    raw.materialOrdinal=preparedRow+1u;
    if (raw.auxiliaryKind==1u)
        return EvaluateRasterLandscape(raw,viewRay,distance,rawUsed,coat,shadow);
    Binding binding=RasterMaterialBindings[raw.materialOrdinal-1u];
    if (binding.materialIndex==0xffffffffu) {
        if ((binding.flags&SurfaceMissingBaseTexturesBinding)!=0u) result.color.a=SurfaceMissingTextures;
        return result;
    }
    if (binding.materialIndex>=RasterRecordCount) return result;
    MaterialRecord material=RasterMaterialRecords[binding.materialIndex];
    uint projectionRow=0xffffffffu;
    // The primary projector and MATO are acquired by the original draw.
    if (raw.auxiliaryKind==2u && ProjectionRowCount>0u &&
        raw.drawIdentity.x!=0u && raw.drawIdentity.x<=(HasRawInput & 0x7fffffffu)) {
        uint row=RasterProjectionLookup.Load((raw.drawIdentity.x-1u)*4u);
        if (row<ProjectionRowCount) projectionRow=row;
    }
    NativeMaterialTriangle tri=(NativeMaterialTriangle)0;
    tri.rasterLocal=true;
    tri.hasTangents=true;
    tri.normals[0]=raw.normal; tri.tangents[0]=raw.tangent; tri.bitangents[0]=raw.bitangent;
    tri.colors[0]=raw.color; tri.uv[0]=raw.uv;
    const float3x3 identity=float3x3(1,0,0,0,1,0,0,0,1);
    result=EvaluateMaterialTriangle(binding,material,tri,mapped.x,float3(1,0,0),viewRay,worldDx,worldDy,1.0,distance,
        identity,identity,ParallaxEnabled!=0u,false,ParallaxShadowEnabled!=0u,MaterialMipBias,
        projectionRow,worldPosition,noise,raw,rawUsed,coat,shadow);
    if (!rawUsed || result.color.a==SurfaceInvalidReceiver) {
        result=(Sample)0; result.color.a=SurfaceEvaluationFailed;
        coat=(NativeCoatSample)0; shadow=(NativeParallaxShadowSample)0; return result;
    }
    if (HasEvaluatedNativeBase(result.color.a)) {
        // Legacy model-space materials use a separate live gloss texture.
        // Do not overwrite authored PBR or complex-environment reflectance.
        if (raw.auxiliaryKind==9u && (material.controls.y&(1u<<9u))!=0u &&
            (material.controls.y&(1u<<8u))==0u) {
            float2 specRG=RawHalf2(raw.auxiliary.x), specBShine=RawHalf2(raw.auxiliary.y);
            float2 scales=RawHalf2(raw.auxiliary.z), minima=RawHalf2(raw.auxiliary.w);
            bool specular=(raw.pixelDescriptor&(1u<<9u))!=0u;
            float gloss=0.0;
            bool glossReady=!specular;
            if (specular && ProjectionRowCount>0u && raw.drawIdentity.x!=0u &&
                raw.drawIdentity.x<=(HasRawInput&0x7fffffffu)) {
                uint row=RasterProjectionLookup.Load((raw.drawIdentity.x-1u)*4u);
                if (row<ProjectionRowCount) {
                    uint4 metadata=ProjectionRecords.Load(int3(0,row,0));
                    uint4 textures=ProjectionRecords.Load(int3(7,row,0));
                    if (metadata.x==0xfffffffbu && metadata.z==row && textures.x<NativeProjectionTextureCapacity) {
                        float bias=exp2(clamp(MaterialMipBias,-8.0,8.0));
                        gloss=NativeProjectionGrad(textures.x,metadata.w&3u,raw.uv,raw.dx*bias,raw.dy*bias).r;
                        glossReady=isfinite(gloss);
                    }
                }
            }
            if (glossReady && all(isfinite(float4(specRG,specBShine))) && all(isfinite(float4(scales,minima)))) {
                gloss=saturate(gloss);
                float shineRough=pow(2.0/(max(specBShine.y,0.0)+2.0),0.25);
                float mapRough=(1.0-gloss)*(1.0-gloss);
                result.normal.w=specular ? clamp(lerp(shineRough,mapRough,saturate(scales.x)*(1.0-gloss))*max(minima.y,0.0),0.045,1.0) : 1.0;
                result.f0.rgb=saturate(max(minima.x,saturate(gloss*float3(specRG,specBShine.x)/3.14159265)*max(scales.y,0.0)));
            }
            result.color.a=SurfaceFeatureLimited;
        }
        if ((binding.flags&SurfaceBaseOnlyBinding)!=0u) result.color.a=SurfaceFeatureLimited;
        if (HasNativeThinSurface(coat)) {
            coat.normalRoughness.xyz=dot(coat.normalRoughness.xyz,viewRay)>0.0 ? -coat.normalRoughness.xyz : coat.normalRoughness.xyz;
            coat.f0Colored.x=raw.front ? coat.f0Colored.x : coat.f0Colored.y;
            result.normal.w=clamp(result.normal.w*(raw.front ? 1.0 : coat.f0Colored.z),0.045,1.0);
            if (dot(result.normal.xyz,viewRay)>0.0) result.normal.xyz=-result.normal.xyz;
        }
    }
    return result;
}

Sample EvaluateScreen(uint2 pixelIndex, out uint2 hitIdentity, out bool rawUsed, out NativeCoatSample coat, out NativeParallaxShadowSample shadow, out bool rayIssued, out bool unresolvedUntraced)
{
    rawUsed=false; rayIssued=false; unresolvedUntraced=false;
    coat=(NativeCoatSample)0;
    shadow=(NativeParallaxShadowSample)0;
    hitIdentity = uint2(0xffffffffu, 0xffffffffu);
    Sample result = (Sample)0;
    uint2 pixel = min(uint2((float2(pixelIndex)+0.5)*float2(ViewSize)/float2(GridSize)),ViewSize-1u);
    float z = ProbeDepth.Load(int3(pixel,0));
    if (!isfinite(z) || z <= 0.0 || z >= 1.0) return result;
    float2 clip = 2.0*(float2(pixel)+0.5)/float2(ViewSize)-1.0;
    clip.y = -clip.y;
    float4 v = mul(InverseProjection,float4(clip,z,1));
    if (!all(isfinite(v)) || abs(v.w)<1e-8) return result;
    float4 w = mul(InverseView,float4(v.xyz/v.w,1));
    float4 camera = mul(InverseView,float4(0,0,0,1));
    if (!all(isfinite(w)) || !all(isfinite(camera)) || abs(w.w)<1e-8 || abs(camera.w)<1e-8) return result;
    float3 origin = camera.xyz/camera.w+PositionAdjust.xyz;
    float3 delta = w.xyz/w.w+PositionAdjust.xyz-origin;
    float distance = length(delta);
    if (!isfinite(distance) || distance <= 1e-6) return result;
    const bool rayRange=distance>0.5 && distance<=60000.0;
    // Only accept the closest native hit when it agrees with raster visibility.
    // Unprepared foreground surfaces must not expose native geometry behind them.
    result.color.a = SurfaceMissingGeometry;
    float tolerance = max(2.0, distance*0.002);
    RayDesc ray;
    ray.Origin=origin; ray.Direction=delta/distance; ray.TMin=0.5; ray.TMax=distance+tolerance;
    // All expensive scene queries use the same frame/quality sampling grid.
    // Non-sampled receivers retain full-resolution material evaluation only
    // when the raster sidecar corroborates a concrete triangle and depth.
    const bool traced = NativeIsSampled(pixel, ViewSize, QualityMode, ProjectionFrame);
    uint2 rasterMapped;
    RawRasterSurface visible=ReadRawVisibility(pixel,z,HasRawInput,rasterMapped);
    if (DiagnosticRayProbe != 0x44585031u && visible.valid) {
        float3 dx=0.0,dy=0.0;
        if (visible.auxiliaryKind==2u) {
            float2 step=2.0/float2(GridSize);
            float3 center=w.xyz/w.w;
            dx=ProbeRayOffset(clip+float2(step.x,0),z,center);
            dy=ProbeRayOffset(clip-float2(0,step.y),z,center);
            // Intersect the adjacent camera rays with the raster normal plane.
            float3 nx=delta+dx,ny=delta+dy;
            float ax=dot(visible.normal,nx),ay=dot(visible.normal,ny);
            dx=abs(ax)>1e-6 ? dx-nx*(dot(visible.normal,dx)/ax) : 0.0;
            dy=abs(ay)>1e-6 ? dy-ny*(dot(visible.normal,dy)/ay) : 0.0;
        }
        result=EvaluateRasterLocal(visible,rasterMapped,delta,distance,origin+delta,dx,dy,
            Random::InterleavedGradientNoise(float2(pixel),ProjectionFrame),rawUsed,coat,shadow);
        if (HasEvaluatedNativeBase(result.color.a)) {
            // Optional correspondence never revokes an otherwise valid material.
            if (rayRange && HasRasterRayMapping!=0u && rasterMapped.x<InstanceCount && rasterMapped.y<0x80000000u && visible.materialIndex!=0xffffffffu) {
                // Do not index the optional scene binding table before range validation.
                if (Bindings[rasterMapped.x].materialIndex!=visible.materialIndex) return result;
                hitIdentity=uint2(rasterMapped.x,rasterMapped.y|0x80000000u);
                if (traced) {
                    rayIssued=true;
                    RayQuery<RAY_FLAG_NONE> correspondence;
                    correspondence.TraceRayInline(ProbeScene,RAY_FLAG_NONE,0xff,ray);
                    while (correspondence.Proceed()) {
                        if (correspondence.CandidateType()==CANDIDATE_NON_OPAQUE_TRIANGLE && AcceptAlpha(correspondence.CandidateInstanceID(),correspondence.CandidatePrimitiveIndex(),correspondence.CandidateTriangleBarycentrics(),InstanceCount))
                            correspondence.CommitNonOpaqueTriangleHit();
                    }
                    if (correspondence.CommittedStatus()==COMMITTED_TRIANGLE_HIT &&
                        correspondence.CommittedInstanceID()==rasterMapped.x && correspondence.CommittedPrimitiveIndex()==rasterMapped.y &&
                        abs(correspondence.CommittedRayT()-distance)<=tolerance) hitIdentity=rasterMapped;
                }
            }
        }
        return result;
    }
    // Certified opaque raster inputs are the only primary visibility
    // authority. A missing/invalid raw receiver cannot become a ray hit.
    if (DiagnosticRayProbe != 0x44585031u) {
        result.color.a=SurfaceInvalidReceiver;
        return result;
    }
    if (HasSecondaryScene==0u || !rayRange) return result;
    uint instance, primitive;
    float2 bary;
    float hitDistance;
    float3x3 worldToObject, objectToWorld;
    bool frontFace;
    RawRasterSurface raw=(RawRasterSurface)0;
    [branch] if (traced) {
        rayIssued=true;
        RayQuery<RAY_FLAG_NONE> query;
        query.TraceRayInline(ProbeScene,RAY_FLAG_NONE,0xff,ray);
        while(query.Proceed()) {
            if (query.CandidateType()==CANDIDATE_NON_OPAQUE_TRIANGLE && AcceptAlpha(query.CandidateInstanceID(),query.CandidatePrimitiveIndex(),query.CandidateTriangleBarycentrics(),InstanceCount))
                query.CommitNonOpaqueTriangleHit();
        }
        if(query.CommittedStatus()!=COMMITTED_TRIANGLE_HIT) return result;
        hitDistance=query.CommittedRayT();
        if(abs(hitDistance-distance)>tolerance) { result.color.a=SurfaceDepthMismatch; return result; }
        instance=query.CommittedInstanceID();
        primitive=query.CommittedPrimitiveIndex();
        bary=query.CommittedTriangleBarycentrics();
        worldToObject=(float3x3)query.CommittedWorldToObject3x4();
        objectToWorld=(float3x3)query.CommittedObjectToWorld3x4();
        frontFace=query.CommittedTriangleFrontFace();
        raw=ReadRawRaster(pixel,z,instance,primitive,HasRawInput);
    } else {
        uint2 candidate;
        if (!ReadRawRasterCandidate(pixel,z,HasRawInput,candidate,raw) ||
            !IntersectRasterCandidate(candidate,origin,ray.Direction,distance,tolerance,bary,hitDistance,worldToObject,objectToWorld)) {
            unresolvedUntraced=true; return result;
        }
        instance=candidate.x; primitive=candidate.y; frontFace=raw.front;
        if ((Bindings[instance].flags & 1024u) != 0u && !AcceptAlpha(instance,primitive,bary,InstanceCount))
            return result;
    }
    if (instance >= InstanceCount) { result.color.a=SurfaceEvaluationFailed; return result; }
    // The material index is a frame-stamped reference, never a second material authority.
    if (raw.valid && raw.materialIndex != 0xffffffffu && raw.materialIndex != Bindings[instance].materialIndex) {
        if (!traced) { unresolvedUntraced=true; return result; }
        raw.valid = false;
    }
    Binding binding = Bindings[instance];
    if (binding.materialIndex >= SceneRecordCount) {
        result.color.a = (binding.flags & SurfaceMissingBaseTexturesBinding) != 0u ?
            SurfaceMissingTextures : SurfaceUnsupportedMaterial;
        return result;
    }
    float3 rayOffsetX=0.0, rayOffsetY=0.0;
    uint projectionRow=0xffffffffu;
    [branch] if (ProjectionRowCount>0u) projectionRow=ProjectionLookup.Load(instance*4u);
    if (projectionRow>=ProjectionRowCount) projectionRow=0xffffffffu;
    if ((ParallaxEnabled!=0u && (binding.flags & SurfaceParallaxReadyBinding)!=0u) || projectionRow!=0xffffffffu) {
        float2 clipStep=2.0/float2(GridSize);
        float3 centerWorld=w.xyz/w.w;
        rayOffsetX=mul(worldToObject,ProbeRayOffset(clip+float2(clipStep.x,0.0),z,centerWorld));
        rayOffsetY=mul(worldToObject,ProbeRayOffset(clip-float2(0.0,clipStep.y),z,centerWorld));
    }
    result=EvaluateMaterial(InstanceCount,instance,primitive,float3(1.0-bary.x-bary.y,bary),
        mul(worldToObject,delta),rayOffsetX,rayOffsetY,hitDistance/distance,hitDistance,
        worldToObject,objectToWorld,ParallaxEnabled!=0u,ParallaxWarpFixEnabled!=0u,ParallaxShadowEnabled!=0u,MaterialMipBias,projectionRow,origin+ray.Direction*hitDistance,Random::InterleavedGradientNoise(float2(pixel),ProjectionFrame),raw,rawUsed,coat,shadow);
    if (!traced && !rawUsed) {
        unresolvedUntraced=true;
        result=(Sample)0; result.color.a=SurfaceMissingGeometry;
        coat=(NativeCoatSample)0; shadow=(NativeParallaxShadowSample)0;
        return result;
    }
    if(result.color.a==SurfaceInvalidReceiver) result.color.a=SurfaceEvaluationFailed;
    // The native output is consumed in world space, including rotated instances.
    if (HasEvaluatedNativeBase(result.color.a)) {
        float3 worldNormal = mul(result.normal.xyz, worldToObject);
        if (all(isfinite(worldNormal)) && dot(worldNormal,worldNormal)>1e-8) {
            result.normal.xyz = normalize(worldNormal);
            if (HasNativeThinSurface(coat)) {
                float3 face=mul(coat.normalRoughness.xyz,worldToObject);
                if (!all(isfinite(face)) || dot(face,face)<1e-8) { coat=(NativeCoatSample)0; result.color.a=SurfaceFeatureLimited; }
                else {
                    face=normalize(face);
                    coat.normalRoughness.xyz=dot(face,delta)>0.0 ? -face : face;
                    bool front=frontFace;
                    coat.f0Colored.x=front ? coat.f0Colored.x : coat.f0Colored.y;
                    result.normal.w=clamp(result.normal.w*(front ? 1.0 : coat.f0Colored.z),0.045,1.0);
                    if (dot(result.normal.xyz,delta)>0.0) result.normal.xyz=-result.normal.xyz;
                }
            }
            if (HasNativeCoat(coat)) {
                float3 worldCoat = mul(coat.normalRoughness.xyz,worldToObject);
                if (all(isfinite(worldCoat)) && dot(worldCoat,worldCoat)>1e-8) coat.normalRoughness.xyz=normalize(worldCoat);
                else { coat=(NativeCoatSample)0; result.color.a=SurfaceFeatureLimited; }
            }
            if ((binding.flags & SurfaceBaseOnlyBinding) != 0u) result.color.a = SurfaceFeatureLimited;
        }
        else result.color.a = SurfaceEvaluationFailed;
    }
    // Only a supported, fully evaluated receiver may provide a candidate identity.
    // The high bit identifies a raster-derived candidate, not a scene RayQuery hit.
    if (result.color.a == SurfaceEvaluatedBase)
        hitIdentity = uint2(instance, primitive | (traced ? 0u : 0x80000000u));
    return result;
}

[numthreads(8,8,1)]
void screenMain(uint3 id : SV_DispatchThreadID, uint lane : SV_GroupIndex)
{
    if (CollectStats != 0u) {
        if (lane < 12) GroupCounts[lane]=0;
        GroupMemoryBarrierWithGroupSync();
    }
    if (all(id.xy < GridSize)) {
        uint2 hitIdentity;
        NativeCoatSample coat;
        NativeParallaxShadowSample shadow;
        bool rawUsed, rayIssued, unresolvedUntraced;
        Sample result=EvaluateScreen(id.xy, hitIdentity, rawUsed, coat, shadow, rayIssued, unresolvedUntraced);
        uint ordinal = id.y*((GridSize.x+7u)&~7u)+id.x;
        uint offset=ordinal*NativeSurfaceStride;
        RayIdentity.Store2(ordinal*8u,hitIdentity);
        uint lobeOffset=ordinal*NativeMaterialLobeStride;
        MaterialLobes.Store4(lobeOffset,uint4(PackHalf4(coat.normalRoughness),PackHalf4(coat.colorStrength)));
        MaterialLobes.Store4(lobeOffset+16u,uint4(PackHalf4(coat.f0Colored),PackHalf4(coat.subsurface)));
        if (ParallaxShadowEnabled!=0u) {
            uint shadowOffset=((GridSize.x+7u)&~7u)*GridSize.y*NativeMaterialLobeStride+ordinal*NativeParallaxShadowStride;
            if (!HasEvaluatedNativeBase(result.color.a)) shadow=(NativeParallaxShadowSample)0;
            MaterialLobes.Store4(shadowOffset,uint4(asuint(shadow.uv),shadow.textureAndMode,asuint(shadow.height)));
            MaterialLobes.Store4(shadowOffset+16u,uint4(PackHalf4(shadow.tangentScale),PackHalf4(shadow.bitangentMip)));
        }
        ScreenOutput.Store4(offset,uint4(PackHalf4(result.color),PackHalf4(result.normal)));
        ScreenOutput.Store4(offset+16u,uint4(PackHalf4(result.f0),PackHalf4(result.emission)));
        uint category = result.color.a==SurfaceEvaluatedBase ? 0 : result.color.a==SurfaceMissingGeometry ? 1 :
            result.color.a==SurfaceDepthMismatch ? 2 : result.color.a==SurfaceEvaluationFailed ? 3 :
            result.color.a==SurfaceFeatureLimited ? 5 : result.color.a==SurfaceUnsupportedMaterial ? 6 :
            result.color.a==SurfaceMissingTextures ? 7 : 4;
        if (CollectStats != 0u) {
            InterlockedAdd(GroupCounts[category],1u);
            if (rawUsed && HasEvaluatedNativeBase(result.color.a)) InterlockedAdd(GroupCounts[8],1u);
            if (rayIssued) InterlockedAdd(GroupCounts[9],1u);
            if (!rayIssued && rawUsed && HasEvaluatedNativeBase(result.color.a)) InterlockedAdd(GroupCounts[10],1u);
            if (unresolvedUntraced) InterlockedAdd(GroupCounts[11],1u);
        }
    }
    if (CollectStats != 0u) {
        GroupMemoryBarrierWithGroupSync();
        if (lane < 12) {
            uint ignored;
            ProbeCounts.InterlockedAdd(lane*4,GroupCounts[lane],ignored);
        }
    }
}
