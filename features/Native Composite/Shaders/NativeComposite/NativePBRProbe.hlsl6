// Representative opaque triangle material evaluation, not a screen renderer.
// Layout matches GpuMaterialAbi.h and DX12NativeAcceleration.h.
struct MaterialRecord {
    uint4 textures[4]; float4 uv[2]; float4 base; float4 coat; float4 surface;
    float4 projected; float4 coatColor; float4 subsurfaceColor; float4 fuzzColor;
    float4 thinSurface; float4 glint; float4 projectedGlint;
    uint4 properties; uint4 identity; uint4 controls;
};
struct Binding { uint2 identity; uint2 revision; uint materialIndex; uint flags; };
struct Sample { float4 color; float4 normal; float4 f0; float4 emission; };
ByteAddressBuffer Geometry : register(t0);
StructuredBuffer<MaterialRecord> Materials : register(t1);
StructuredBuffer<Binding> Bindings : register(t2);
Texture2DArray<float4> Textures[512] : register(t3);
RWStructuredBuffer<Sample> Output : register(u0);
SamplerState ClampClamp : register(s0);
SamplerState ClampWrap : register(s1);
SamplerState WrapClamp : register(s2);
SamplerState WrapWrap : register(s3);
cbuffer Constants : register(b0) { uint InstanceCount; };
float4 Tex(uint index, float2 uv, uint mode)
{
    uint slot = NonUniformResourceIndex(index);
    if (mode == 0u) return Textures[slot].SampleLevel(ClampClamp, float3(uv,0), 0);
    if (mode == 1u) return Textures[slot].SampleLevel(ClampWrap, float3(uv,0), 0);
    if (mode == 2u) return Textures[slot].SampleLevel(WrapClamp, float3(uv,0), 0);
    return Textures[slot].SampleLevel(WrapWrap, float3(uv,0), 0);
}
float3 SrgbToLinear(float3 v)
{
    v = max(v,0);
    return lerp(v/12.92, pow((v+0.055)/1.055,2.4), v>0.04045);
}
[numthreads(64,1,1)]
void main(uint3 id : SV_DispatchThreadID)
{
    uint instance = id.x;
    if (instance >= InstanceCount) return;
    Sample result = (Sample)0;
    Output[instance] = result;
    Binding binding = Bindings[instance];
    uint4 offsets = Geometry.Load4(instance*32);
    uint4 counts = Geometry.Load4(instance*32+16);
    if (binding.materialIndex == 0xffffffffu || offsets.z == 0xffffffffu || offsets.w != 60u || counts.y < 3u) return;
    MaterialRecord material = Materials[binding.materialIndex];
    if (any(material.identity.xy != binding.identity) || any(material.identity.zw != binding.revision)) return;
    uint3 ix = Geometry.Load3(offsets.y);
    if (any(ix >= counts.x)) return;
    float3 n = 0, t = 0, b = 0, color = 0;
    float2 uv = 0;
    [unroll] for (uint i = 0; i < 3u; ++i) {
        uint a = offsets.z + ix[i]*offsets.w;
        n += asfloat(Geometry.Load3(a));
        uv += asfloat(Geometry.Load2(a+12));
        color += asfloat(Geometry.Load3(a+20));
        t += asfloat(Geometry.Load3(a+36));
        b += asfloat(Geometry.Load3(a+48));
    }
    uv = (uv/3.0)*material.uv[0].zw+material.uv[0].xy;
    float4 baseTexel = Tex(material.textures[0].x,uv,material.properties.z);
    float4 normalTexel = Tex(material.textures[0].z,uv,material.properties.z);
    float4 packed = Tex(material.textures[1].x,uv,material.properties.z);
    float3 sampled = normalTexel.xyz*2.0-1.0;
    if ((binding.flags & 256u) != 0u) sampled.z = sqrt(saturate(1.0-dot(sampled.xy,sampled.xy)));
    if (dot(n,n) < 1e-8 || dot(sampled,sampled) < 1e-8) return;
    n = normalize(n);
    t -= n*dot(n,t);
    if (dot(t,t) < 1e-8) return;
    t = normalize(t);
    b = cross(n,t)*(dot(cross(n,t),b)<0.0 ? -1.0 : 1.0);
    float3 normal = (binding.flags & 512u) != 0u ? normalize(sampled) : normalize(t*sampled.x+b*sampled.y+n*sampled.z);
    float3 base = baseTexel.rgb;
    if ((binding.flags & 1u) != 0u) base *= SrgbToLinear(color/3.0);
    float metallic = saturate(packed.g);
    float roughness = clamp(packed.r*material.base.y,0.045,1.0);
    float3 f0 = lerp(saturate(packed.a*material.base.w).xxx,base,metallic);
    float3 emission = 0;
    if (material.textures[1].z != 0xffffffffu) emission = Tex(material.textures[1].z,uv,material.properties.z).rgb;
    if (!all(isfinite(base)) || !all(isfinite(normal)) || !all(isfinite(f0)) || !all(isfinite(emission))) return;
    result.color = float4(base,1.0);
    result.normal = float4(normal,roughness);
    result.f0 = float4(f0,metallic);
    result.emission = float4(emission,saturate(packed.b));
    Output[instance] = result;
}
