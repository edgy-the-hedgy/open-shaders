#include "NativeSurface.hlsli"
#include "NativeIndirectBRDF.hlsli"
#include "NativeEnvironmentColor.hlsli"

ByteAddressBuffer Materials : register(t0);
Texture2D<float> RasterDepth : register(t1);
ByteAddressBuffer EnvironmentSH : register(t2);
ByteAddressBuffer SkySH : register(t3);
TextureCube<float4> Environment : register(t4);
TextureCube<float4> Reflections : register(t5);
SamplerState LinearSampler : register(s0);
RWByteAddressBuffer Lighting : register(u0);

cbuffer IndirectInputs : register(b0)
{
    row_major float4x4 InverseProjection;
    row_major float4x4 InverseView;
    uint2 Size;
    uint MaterialPitch;
    uint LightingPitch;
    uint EnabledContributions;
    uint AvailableContributions;
    uint EnvironmentMipCount;
    uint ReflectionMipCount;
    float EnvironmentScale;
    float SkyScale;
    uint Interior;
    uint ColorEncoding;
    float4 DALC[3];
    float EnvironmentSaturation;
    float SkySaturation;
    float DALCAmount;
    float AmbientMultiplier;
    float ConversionSaturation;
    float UtilitySaturation;
    float UtilityGammaOffset;
    uint DALCMode;
    uint IBLEnabled;
    uint DALCValid;
    uint2 Padding;
};

float Luminance(float3 c) { return dot(c, float3(0.2125, 0.7154, 0.0721)); }
float3 SaturateColor(float3 c, float amount) { return max(0.0, lerp(Luminance(c).xxx, c, amount)); }

float3 EngineAmbient(float3 direction, float amount)
{
    float3 c = max(0.0, float3(dot(DALC[0], SphericalHarmonics::Evaluate(direction)),
        dot(DALC[1], SphericalHarmonics::Evaluate(direction)),
        dot(DALC[2], SphericalHarmonics::Evaluate(direction))));
    float gamma = ColorEncoding == 0u ? 1.0 : 2.2;
    if (ColorEncoding != 0u)
    {
        c = lerp(c / 12.92, pow((c + 0.055) / 1.055, 2.4), step(0.04045, c));
        c = SaturateColor(c, min(ConversionSaturation, 1.0));
    }
    c = pow(c, clamp(gamma + UtilityGammaOffset, 0.1, 3.0) / gamma);
    c = SaturateColor(c, UtilitySaturation) * AmbientMultiplier * amount;
    return ColorEncoding == 0u ? pow(max(c, 0.0), 1.6) : c;
}

float3 BaseIrradiance(float3 direction)
{
    return NativeIndirect::EvaluateIrradiance(asfloat(EnvironmentSH.Load4(0u)),
        asfloat(EnvironmentSH.Load4(16u)), asfloat(EnvironmentSH.Load4(32u)), direction);
}

float3 EnvironmentIrradiance(float3 direction)
{
    if (IBLEnabled == 0u) return EngineAmbient(direction, 1.0);
    if (DALCMode >= 2u) return EngineAmbient(direction, DALCAmount);
    float3 result = SaturateColor(BaseIrradiance(direction), EnvironmentSaturation);
    if (DALCAmount != 0.0)
    {
        float3 reference = SaturateColor(BaseIrradiance(0.0), EnvironmentSaturation);
        float3 target = EngineAmbient(0.0, 1.0);
        float3 ratio = DALCMode == 0u ? (Luminance(target) / max(0.001, Luminance(reference))).xxx :
            target / max(0.001, reference);
        result *= lerp(1.0, ratio, saturate(DALCAmount));
    }
    return result * EnvironmentScale;
}

float4 UnpackHalf4(uint2 value)
{
    return f16tof32(uint4(value.x & 65535u, value.x >> 16, value.y & 65535u, value.y >> 16));
}

bool ViewDirection(uint2 pixel, out float3 view)
{
    view = 0.0;
    float depth = RasterDepth.Load(int3(pixel, 0));
    if (!isfinite(depth) || depth <= 0.0 || depth >= 1.0) return false;
    float2 clip = 2.0 * (float2(pixel) + 0.5) / float2(Size) - 1.0;
    clip.y = -clip.y;
    float4 p = mul(InverseProjection, float4(clip, depth, 1.0));
    if (!all(isfinite(p)) || abs(p.w) < 1e-8) return false;
    float3 delta = mul((float3x3)InverseView, -p.xyz / p.w);
    float lengthSquared = dot(delta, delta);
    if (!all(isfinite(delta)) || !isfinite(lengthSquared) || lengthSquared < 1e-8) return false;
    view = delta * rsqrt(lengthSquared);
    return true;
}

[numthreads(8, 8, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= Size)) return;
    uint offset = id.y * MaterialPitch + id.x * NativeSurfaceStride;
    uint outputOffset = id.y * LightingPitch + id.x * 16u;
    Lighting.Store4(outputOffset, uint4(0, 0, 0, 0));
    float4 base = UnpackHalf4(Materials.Load2(offset));
    float4 normal = UnpackHalf4(Materials.Load2(offset + 8u));
    float4 f0 = UnpackHalf4(Materials.Load2(offset + 16u));
    float4 emissionAO = UnpackHalf4(Materials.Load2(offset + 24u));
    if (!HasEvaluatedNativeBase(base.a) || !all(isfinite(base)) || !all(isfinite(normal)) ||
        !all(isfinite(f0)) || !all(isfinite(emissionAO)) || dot(normal.xyz, normal.xyz) < 1e-8) return;
    float3 view;
    if (!ViewDirection(id.xy, view)) return;
    float3 n = normalize(normal.xyz);
    float roughness = clamp(normal.w, 0.045, 1.0);
    NativeIndirect::LobeWeights lobes = NativeIndirect::EvaluateLobes(base.rgb, f0.rgb, f0.a,
        roughness, emissionAO.a, saturate(dot(n, view)));
    uint active = EnabledContributions & AvailableContributions;
    if ((active & ContributionIndirectDiffuse) != 0u)
    {
        float3 radiance = EnvironmentIrradiance(n);
        if (IBLEnabled != 0u && Interior == 0u)
            radiance += SaturateColor(NativeIndirect::EvaluateIrradiance(asfloat(SkySH.Load4(0u)),
                asfloat(SkySH.Load4(16u)), asfloat(SkySH.Load4(32u)), n), SkySaturation) * SkyScale;
        Lighting.Store2(outputOffset, PackOpaqueRadiance(radiance * lobes.diffuse, ContributionIndirectDiffuse));
    }
    if ((active & ContributionIndirectSpecular) != 0u && EnvironmentMipCount != 0u &&
        (Interior != 0u || ReflectionMipCount != 0u))
    {
        float3 r = reflect(-view, n);
        float level = roughness * float(EnvironmentMipCount - 1u);
        float3 env = DecodeEnvironmentRadiance(Environment.SampleLevel(LinearSampler, r, level).rgb, ColorEncoding);
        float target = Luminance(EnvironmentIrradiance(-r));
        float normalization = Luminance(DecodeEnvironmentRadiance(Environment.SampleLevel(LinearSampler, r, float(EnvironmentMipCount - 1u)).rgb, ColorEncoding));
        float3 radiance = env * target / max(0.001, normalization);
        if (Interior == 0u)
        {
            float3 full = DecodeEnvironmentRadiance(Reflections.SampleLevel(LinearSampler, r, roughness * float(ReflectionMipCount - 1u)).rgb, ColorEncoding);
            if (IBLEnabled != 0u) radiance += max(0.0, full - env) * SkyScale;
            else
            {
                float reference = Luminance(DecodeEnvironmentRadiance(Reflections.SampleLevel(LinearSampler, r, float(ReflectionMipCount - 1u)).rgb, ColorEncoding));
                radiance = full * target / max(0.001, reference);
            }
        }
        Lighting.Store2(outputOffset + 8u, PackOpaqueRadiance(radiance * lobes.specular, ContributionIndirectSpecular));
    }
}
