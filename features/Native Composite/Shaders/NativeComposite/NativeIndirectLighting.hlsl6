#include "NativeSurface.hlsli"
#include "FullNativeSampling.hlsli"
#include "NativeFuzz.hlsli"
#ifdef NATIVE_SPECIALIZED_V2_RUNTIME
#include "NativeSpecializedLighting.hlsli"
#endif
#include "NativeIndirectBRDF.hlsli"
#include "NativeEnvironmentColor.hlsli"

ByteAddressBuffer Materials : register(t0);
Texture2D<float> RasterDepth : register(t1);
ByteAddressBuffer EnvironmentSH : register(t2);
ByteAddressBuffer SkySH : register(t3);
TextureCube<float4> Environment : register(t4);
TextureCube<float4> Reflections : register(t5);
RaytracingAccelerationStructure Scene : register(t6);
#define NATIVE_GEOMETRY_REGISTER t7
#define NATIVE_RECORD_REGISTER t8
#define NATIVE_BINDING_REGISTER t9
#define NATIVE_TEXTURE_REGISTER t10
#define NATIVE_CHARACTER_REFLECTION
#include "NativeMaterialAlpha.hlsli"
#ifdef NATIVE_SPECIALIZED_V2_RUNTIME
ByteAddressBuffer SpecializedDirectory : register(t522);
ByteAddressBuffer SpecializedPool : register(t0,space2);
cbuffer SpecializedLightingInputs : register(b0,space2) { uint SpecializedCapacity; uint SpecializedEnabled; };
#else
ByteAddressBuffer MaterialLobes : register(t522);
#endif
RaytracingAccelerationStructure CharacterScene : register(t523);
ByteAddressBuffer SSRDirect : register(t524);
ByteAddressBuffer SSRRayIdentity : register(t525);
ByteAddressBuffer SSRTokenTable : register(t526);
Texture2D<float4> SSRTokens : register(t527);
ByteAddressBuffer SecondaryLights : register(t528);
RWByteAddressBuffer Lighting : register(u0);

cbuffer IndirectInputs : register(b0)
{
    row_major float4x4 InverseProjection;
    row_major float4x4 InverseView;
    uint2 Size;
    uint MaterialPitch;
    uint LightingPitch;
    uint EnabledContributions;
    uint AvailableContributions;
    uint EnvironmentMipCount;
    uint ReflectionMipCount;
    float EnvironmentScale;
    float SkyScale;
    uint Interior;
    uint ColorEncoding;
    float4 DALC[3];
    float EnvironmentSaturation;
    float SkySaturation;
    float DALCAmount;
    float AmbientMultiplier;
    float ConversionSaturation;
    float UtilitySaturation;
    float UtilityGammaOffset;
    uint DALCMode;
    uint IBLEnabled;
    uint DALCValid;
    uint2 Padding;
    float MinDiffuseSkyVisibility;
    float MinSpecularSkyVisibility;
    float SkyMinZ;
    uint TraceSkyVisibility;
    float4 PositionAdjust;
    uint InstanceCount;
    uint CharacterCastersEnabled;
    uint QualityMode;
    uint FrameIndex;
    row_major float4x4 SSRProjection;
    row_major float4x4 SSRView;
    uint SSREnabled;
    uint SSRDirectPitch;
    uint SSRRayPitch;
    uint SSRTokenCount;
    float4 SecondarySunDirection, SecondarySunRadiance;
    uint SecondaryLightCount, SecondaryFoliage;
    uint SkyAvailable, SecondaryMaterialControls;
    uint SecondaryProjectionRows;
    uint CharacterVertexCount, CharacterTriangleCount, CharacterPartCount;
    uint CharacterMoverCount;
    uint MaterialLobePitch;
    uint2 CharacterPadding;
};
#include "NativeSecondaryReflection.hlsli"

float Luminance(float3 c) { return dot(c, float3(0.2125, 0.7154, 0.0721)); }
float3 SaturateColor(float3 c, float amount) { return max(0.0, lerp(Luminance(c).xxx, c, amount)); }

float3 EngineAmbient(float3 direction, float amount)
{
    float3 c = max(0.0, float3(dot(DALC[0], SphericalHarmonics::Evaluate(direction)),
        dot(DALC[1], SphericalHarmonics::Evaluate(direction)),
        dot(DALC[2], SphericalHarmonics::Evaluate(direction))));
    float gamma = ColorEncoding == 0u ? 1.0 : 2.2;
    if (ColorEncoding != 0u)
    {
        c = lerp(c / 12.92, pow((c + 0.055) / 1.055, 2.4), step(0.04045, c));
        c = SaturateColor(c, min(ConversionSaturation, 1.0));
    }
    c = pow(c, clamp(gamma + UtilityGammaOffset, 0.1, 3.0) / gamma);
    c = SaturateColor(c, UtilitySaturation) * AmbientMultiplier * amount;
    return ColorEncoding == 0u ? pow(max(c, 0.0), 1.6) : c;
}

// The cube producer uses incoming directions (ReadNativeRadiance projects
// -direction); NativePBR normals and reflection vectors point outward.
float3 BaseIrradiance(float3 direction)
{
    return NativeIndirect::EvaluateIrradiance(asfloat(EnvironmentSH.Load4(0u)),
        asfloat(EnvironmentSH.Load4(16u)), asfloat(EnvironmentSH.Load4(32u)), direction);
}

float3 BaseMean()
{
    // The L0 coefficient is the spherical mean divided by Y00.
    return max(0.0, float3(asfloat(EnvironmentSH.Load(0u)),
        asfloat(EnvironmentSH.Load(16u)), asfloat(EnvironmentSH.Load(32u))) * 0.2820947918);
}

float3 EnvironmentRatio()
{
    if (DALCValid == 0u || DALCAmount == 0.0 || DALCMode >= 2u) return 1.0;
    float3 reference = SaturateColor(BaseMean(), EnvironmentSaturation);
    float3 target = EngineAmbient(0.0, 1.0);
    float lum = Luminance(reference);
    float3 ratio = DALCMode == 0u ? (lum > 0.001 ? Luminance(target) / lum : 1.0).xxx :
        target / max(0.001, reference);
    return lerp(1.0, ratio, saturate(DALCAmount));
}

float3 EnvironmentIrradiance(float3 direction)
{
    if (DALCMode >= 2u) return EngineAmbient(direction, DALCAmount);
    return SaturateColor(BaseIrradiance(direction), EnvironmentSaturation) * EnvironmentRatio() * EnvironmentScale;
}

float3 SkyIrradiance(float3 direction)
{
    if (Interior != 0u || SkyAvailable == 0u) return 0.0;
    return SaturateColor(NativeIndirect::EvaluateIrradiance(asfloat(SkySH.Load4(0u)),
        asfloat(SkySH.Load4(16u)), asfloat(SkySH.Load4(32u)), direction), SkySaturation) * SkyScale;
}

float3 CubemapSpecularMiss(float3 direction, float roughness)
{
    const float level = saturate(roughness) * float(EnvironmentMipCount - 1u);
    float3 base = DecodeEnvironmentRadiance(Environment.SampleLevel(ClampClamp,-direction,level).rgb,ColorEncoding);
    if (!all(isfinite(base))) return base;
    base = max(0.0, base);
    float3 radiance = SaturateColor(base, EnvironmentSaturation) * EnvironmentRatio() * EnvironmentScale;
    if (DALCMode >= 2u)
        radiance = base / max(0.001, Luminance(BaseMean())) * EngineAmbient(direction, DALCAmount);
    // The full exterior reflection cube includes environment + sky. Add only
    // the residual to avoid adding the base environment a second time.
    if (Interior == 0u && ReflectionMipCount != 0u) {
        float3 full = DecodeEnvironmentRadiance(Reflections.SampleLevel(ClampClamp,-direction,
            saturate(roughness)*float(ReflectionMipCount-1u)).rgb,ColorEncoding);
        if (!all(isfinite(full))) return full;
        full = max(0.0, full);
        radiance += SaturateColor(max(0.0, full-base), SkySaturation) * SkyScale;
    }
    // PackOpaqueRadiance rejects nonfinite/overflow instead of certifying black.
    return radiance;
}

float4 UnpackHalf4(uint2 value)
{
    return f16tof32(uint4(value.x & 65535u, value.x >> 16, value.y & 65535u, value.y >> 16));
}

bool ViewDirection(uint2 pixel, out float3 view, out float3 world)
{
    view = 0.0; world = 0.0;
    float depth = RasterDepth.Load(int3(pixel, 0));
    if (!isfinite(depth) || depth <= 0.0 || depth >= 1.0) return false;
    float2 clip = 2.0 * (float2(pixel) + 0.5) / float2(Size) - 1.0;
    clip.y = -clip.y;
    float4 p = mul(InverseProjection, float4(clip, depth, 1.0));
    if (!all(isfinite(p)) || abs(p.w) < 1e-8) return false;
    float3 delta = mul((float3x3)InverseView, -p.xyz / p.w);
    float lengthSquared = dot(delta, delta);
    if (!all(isfinite(delta)) || !isfinite(lengthSquared) || lengthSquared < 1e-8) return false;
    view = delta * rsqrt(lengthSquared);
    float4 absolute = mul(InverseView, float4(p.xyz / p.w, 1.0));
    if (!all(isfinite(absolute)) || abs(absolute.w) < 1e-8) return false;
    world = absolute.xyz / absolute.w + PositionAdjust.xyz;
    return all(isfinite(world));
}

// Inline DXR determines the nearest reflection intersection. Projection is
// only a lookup of validated, same-frame direct+emissive hit radiance.
bool SSRProject(float3 absolute, out uint2 pixel, out float2 uv, out float depth)
{
    pixel=0; uv=0; depth=0;
    float4 clip=mul(SSRProjection,mul(SSRView,float4(absolute-PositionAdjust.xyz,1)));
    if (!all(isfinite(clip)) || abs(clip.w)<1e-5) return false;
    uv=clip.xy/clip.w*float2(0.5,-0.5)+0.5;
    depth=clip.z/clip.w;
    if (any(uv<0) || any(uv>=1) || depth<=0 || depth>=1) return false;
    pixel=uint2(uv*float2(Size));
    return all(pixel<Size);
}
bool SSREvidence(uint2 p, out uint2 identity)
{
    identity=uint2(0xffffffffu,0xffffffffu);
    uint token=uint(round(saturate(SSRTokens.Load(int3(p,0)).b)*65535.0));
    if (token==0 || token>SSRTokenCount) return false;
    uint2 hit=SSRRayIdentity.Load2(p.y*SSRRayPitch+p.x*8u);
    identity=uint2(hit.x,hit.y&0x7fffffffu);
    return all(hit!=0xffffffffu) && all(SSRTokenTable.Load2((token-1u)*8u)==identity);
}
float3 ResolveRayReflection(uint2 receiver,float3 world,float3 normal,float3 direction,float roughness,uint lobe,float3 fallback)
{
    // Zero static instances explicitly means the primary material frame has
    // no ray scene. Environment-only evaluation never touches a null TLAS.
    [branch] if (SSREnabled==0 || InstanceCount==0u || roughness>=0.99) return fallback;
    // A raster token corroborates receiver identity when present. Material
    // correspondence and final opaque ownership are validated separately.
    // Receiver screen evidence is optional; only screen hit reuse needs it.
    const float spread=roughness*roughness*ShadowEmitterMultiplier(QualityMode);
    float3 d=normalize(direction+NativeEmitterOffset(direction,spread,receiver,lobe,FrameIndex));
    if (!all(isfinite(d)) || dot(normal,d)<=0.0) return fallback;
    RayDesc ray;
    ray.Origin=world+normal*0.5;
    ray.Direction=d;
    ray.TMin=0.5;
    ray.TMax=3.402823e38;
    RayQuery<RAY_FLAG_NONE> query;
    query.TraceRayInline(Scene,RAY_FLAG_NONE,0xff,ray);
    while(query.Proceed()) {
        if(query.CandidateType()==CANDIDATE_NON_OPAQUE_TRIANGLE &&
            AcceptAlpha(query.CandidateInstanceID(),query.CandidatePrimitiveIndex(),query.CandidateTriangleBarycentrics(),InstanceCount))
            query.CommitNonOpaqueTriangleHit();
    }
    const bool staticHit=query.CommittedStatus()==COMMITTED_TRIANGLE_HIT;
    const float distance=staticHit?query.CommittedRayT():ray.TMax;
    if(CharacterCastersEnabled!=0u && distance>ray.TMin) {
        ray.TMax=distance;
        RayQuery<RAY_FLAG_FORCE_OPAQUE> character;
        character.TraceRayInline(CharacterScene,RAY_FLAG_NONE,0xff,ray);
        while(character.Proceed()) {}
        if(character.CommittedStatus()==COMMITTED_TRIANGLE_HIT) {
            const float hitDistance=character.CommittedRayT();
            float3 characterRadiance;
            if(ShadeNativeCharacterSecondary(character.CommittedInstanceID(),character.CommittedPrimitiveIndex(),
                character.CommittedTriangleBarycentrics(),character.CommittedTriangleFrontFace(),
                (float3x3)character.CommittedWorldToObject3x4(),(float3x3)character.CommittedObjectToWorld3x4(),
                ray.Origin+d*hitDistance,d,hitDistance,roughness,receiver,lobe,FrameIndex,QualityMode,
                InstanceCount,CharacterCastersEnabled,SecondaryLightCount,SecondarySunDirection,SecondarySunRadiance,
                SecondaryFoliage,SecondaryMaterialControls,CharacterVertexCount,CharacterTriangleCount,CharacterPartCount,CharacterMoverCount,characterRadiance))
                return lerp(fallback,characterRadiance,saturate(1.0-roughness));
            return fallback;
        }
    }
    if(!staticHit)return fallback;
    const uint2 committed=uint2(query.CommittedInstanceID(),query.CommittedPrimitiveIndex());
    float3 secondary;
    if (ShadeNativeSecondary(committed.x,committed.y,query.CommittedTriangleBarycentrics(),
        (float3x3)query.CommittedWorldToObject3x4(),(float3x3)query.CommittedObjectToWorld3x4(),query.CommittedTriangleFrontFace(),
        ray.Origin+d*distance,d,distance,roughness,receiver,lobe,FrameIndex,QualityMode,InstanceCount,CharacterCastersEnabled,
        SecondaryLightCount,SecondarySunDirection,SecondarySunRadiance,SecondaryFoliage,SecondaryMaterialControls,SecondaryProjectionRows,secondary))
        return lerp(fallback,secondary,saturate(1.0-roughness));
    if (SSRTokenCount==0u) return fallback;
    uint2 hit,hitIdentity; float2 uv; float projectedDepth;
    if (!SSRProject(ray.Origin+d*distance,hit,uv,projectedDepth) ||
        all(hit==receiver) || !NativeIsSampled(hit,Size,QualityMode,FrameIndex) ||
        !SSREvidence(hit,hitIdentity) || any(hitIdentity!=committed)) return fallback;
    float rasterDepth=RasterDepth.Load(int3(hit,0));
    if(!isfinite(rasterDepth) || abs(rasterDepth-projectedDepth)>0.0005) return fallback;
    const uint materialOffset=hit.y*MaterialPitch+hit.x*NativeSurfaceStride;
    float4 b=UnpackHalf4(Materials.Load2(materialOffset));
    float4 n=UnpackHalf4(Materials.Load2(materialOffset+8u));
    float4 e=UnpackHalf4(Materials.Load2(materialOffset+24u));
    if (b.a!=SurfaceEvaluatedBase || !all(isfinite(n)) || !all(isfinite(e)) || dot(n.xyz,-d)<=0.0) return fallback;
    uint offset=hit.y*SSRDirectPitch+hit.x*NativeLightingStride;
    float4 diffuse=UnpackHalf4(SSRDirect.Load2(offset));
    float4 transmission=UnpackHalf4(SSRDirect.Load2(offset+16u));
    if (!all(isfinite(diffuse)) || diffuse.a<=0 || !all(isfinite(transmission)) ||
        transmission.a!=float(ContributionTransmission)) return fallback;
    float3 radiance=max(diffuse.rgb+transmission.rgb+e.rgb,0.0);
    if (!all(isfinite(radiance)) || any(radiance>65504.0)) return fallback;
    float edge=saturate(min(min(uv.x,uv.y),min(1-uv.x,1-uv.y))*12.0);
    return lerp(fallback,radiance,edge*saturate(1.0-roughness));
}

[numthreads(8, 8, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    uint2 pixel = NativeSamplePixel(id.xy, Size, QualityMode, FrameIndex);
    if (any(pixel >= Size)) return;
    uint offset = pixel.y * MaterialPitch + pixel.x * NativeSurfaceStride;
    uint outputOffset = pixel.y * LightingPitch + pixel.x * NativeLightingStride;
    Lighting.Store4(outputOffset, uint4(0, 0, 0, 0));
    Lighting.Store2(outputOffset+16u,uint2(0,0));
    float4 base = UnpackHalf4(Materials.Load2(offset));
    float4 normal = UnpackHalf4(Materials.Load2(offset + 8u));
    float4 f0 = UnpackHalf4(Materials.Load2(offset + 16u));
    float4 emissionAO = UnpackHalf4(Materials.Load2(offset + 24u));
#ifndef NATIVE_SPECIALIZED_V2_RUNTIME
    NativeCoatSample coat=ReadNativeCoat(MaterialLobes,pixel.y*MaterialLobePitch+pixel.x*NativeSurfaceStride);
#endif
    if (!HasEvaluatedNativeBase(base.a) || !all(isfinite(base)) || !all(isfinite(normal)) ||
        !all(isfinite(f0)) || !all(isfinite(emissionAO)) || dot(normal.xyz, normal.xyz) < 1e-8) return;
    float3 view, world;
    if (!ViewDirection(pixel, view, world)) return;
    float3 n = normalize(normal.xyz);
#ifdef NATIVE_SPECIALIZED_V2_RUNTIME
    NativeSpecializedLighting s=ReadSpecializedLighting(SpecializedDirectory,SpecializedPool,offset/NativeSurfaceStride,SpecializedCapacity,SpecializedEnabled,n);
    float3 baseView=NativeSpecializedBaseDirection(view,s);
    float roughness=clamp(normal.w,0.045,1.0);
    NativeIndirect::LobeWeights lobes=NativeIndirect::EvaluateLobes(base.rgb,f0.rgb,f0.a,roughness,emissionAO.a,saturate(dot(n,baseView)));
    PBR::FuzzLayer fuzz=ResolveSpecializedFuzz(s,roughness,n,view,false);
    bool thin=NativeLobeAvailable(s,SpecializedThin);
    float3 transmissionWeight=0.0,backTransmissionWeight=0.0;
    float3 albedo=max(base.rgb,0.0)*(1.0-saturate(f0.a));
    float2 env=BRDF::EnvBRDF(roughness,saturate(abs(dot(n,view))));
    float3 fresnel=saturate(f0.rgb*env.x+env.y);
    if(thin) {
        float front=NativeLobeAvailable(s,SpecializedFront)?s.frontWeight:0.0;
        float back=NativeLobeAvailable(s,SpecializedBack)?s.backWeight:0.0;
        float control=NativeLobeAvailable(s,SpecializedSpecularControls)?s.specularControls.x:1.0;
        float3 throughput=saturate(MultiBounceAO(saturate(albedo),saturate(emissionAO.a)))*(1.0-fresnel*control);
        lobes.diffuse=albedo*saturate(1.0-front-back)*throughput;
        lobes.specular*=control;
        transmissionWeight=NativeSpecializedScatterColor(s,albedo)*front*throughput;
        backTransmissionWeight=NativeSpecializedScatterColor(s,albedo)*back*throughput;
    } else if(NativeLobeAvailable(s,SpecializedSSS)) {
        lobes.diffuse*=s.opacity;
        transmissionWeight=s.sssColor*(1.0-s.opacity)*BRDF::Diffuse_Lambert()*(1.0-fresnel);
    }
    lobes.diffuse=lobes.diffuse*(1.0-fuzz.weightedAlbedo)+fuzz.weightedAlbedo*fuzz.color*saturate(emissionAO.a);
    lobes.specular*=fuzz.specularThroughput;
    transmissionWeight*=1.0-fuzz.weightedAlbedo; backTransmissionWeight*=1.0-fuzz.weightedAlbedo;
    bool hasCoat=NativeLobeAvailable(s,SpecializedCoat);
    float3 cn=s.coatNormal;
    float coatRoughness=s.coatRoughness;
    float3 coatSpecularWeight=0.0,coatDiffuseWeight=0.0;
    if(hasCoat) {
        float2 cb=BRDF::EnvBRDF(coatRoughness,saturate(abs(dot(cn,view))));
        float reflected=saturate(s.coatF0*cb.x+cb.y);
        float attenuation=1.0-reflected*s.coatStrength;
        lobes.diffuse*=attenuation; lobes.specular*=attenuation;
        transmissionWeight*=attenuation; backTransmissionWeight*=attenuation;
        coatSpecularWeight=reflected*s.coatStrength;
        if(NativeLobeAvailable(s,SpecializedColoredCoat)) {
            lobes.diffuse*=1.0-s.coatStrength; lobes.specular*=1.0-s.coatStrength;
            transmissionWeight*=1.0-s.coatStrength; backTransmissionWeight*=1.0-s.coatStrength;
            coatDiffuseWeight=s.coatColor*(1.0-reflected)*s.coatStrength;
        }
    }
    bool transmissionValid=NativeSpecializedTransmissionValid(s);
    float3 reflectionNormal=NativeSpecializedAnisoNormal(s,s.eyeNormal,view);
#else
    float3 baseView=NativeBaseDirection(view,coat);
    float roughness = clamp(normal.w, 0.045, 1.0);
    NativeIndirect::LobeWeights lobes = NativeIndirect::EvaluateLobes(base.rgb, f0.rgb, f0.a,
        roughness, emissionAO.a, saturate(dot(n, baseView)));
    PBR::FuzzLayer fuzz=ResolveNativeFuzz(coat,roughness,n,view,false);
    float3 transmissionWeight=0.0, backTransmissionWeight=0.0;
    if (HasNativeThinSurface(coat)) {
        float3 reflected,front,back;
        float3 albedo=max(base.rgb,0.0)*(1.0-saturate(f0.a));
        NativeThinAlbedos(albedo,coat,reflected,front,back);
        float2 env=BRDF::EnvBRDF(roughness,saturate(abs(dot(n,view))));
        float weight=saturate(coat.f0Colored.x);
        float3 fresnel=saturate(f0.rgb*env.x+env.y)*weight;
        float3 throughput=saturate(MultiBounceAO(saturate(albedo),saturate(emissionAO.a)))*(1.0-fresnel);
        lobes.diffuse=reflected*throughput;
        lobes.specular*=weight;
        transmissionWeight=front*throughput;
        backTransmissionWeight=back*throughput;
    }
    if (!HasNativeThinSurface(coat) && HasNativeSubsurface(coat)) {
        float2 env=BRDF::EnvBRDF(roughness,saturate(dot(n,view)));
        float3 reflected=saturate(f0.rgb*env.x+env.y);
        transmissionWeight=coat.subsurface.rgb*(1.0-saturate(coat.subsurface.w))*BRDF::Diffuse_Lambert()*(1.0-reflected);
    }
    lobes.diffuse=lobes.diffuse*(1.0-fuzz.weightedAlbedo)+fuzz.weightedAlbedo*fuzz.color*saturate(emissionAO.a);
    lobes.specular*=fuzz.specularThroughput;
    transmissionWeight*=1.0-fuzz.weightedAlbedo;
    backTransmissionWeight*=1.0-fuzz.weightedAlbedo;
    bool hasCoat = HasNativeCoat(coat);
    float3 cn = hasCoat ? normalize(coat.normalRoughness.xyz) : n;
    float3 coatSpecularWeight = 0.0;
    float3 coatDiffuseWeight = 0.0;
    if (hasCoat) {
        float2 coatBRDF = BRDF::EnvBRDF(coat.normalRoughness.w,saturate(abs(dot(cn,view))));
        float3 reflected = saturate(coat.f0Colored.rgb*coatBRDF.x+coatBRDF.y);
        float strength=saturate(coat.colorStrength.w);
        lobes.diffuse *= 1.0-reflected*strength;
        lobes.specular *= 1.0-reflected*strength;
        coatSpecularWeight=reflected*strength;
        if (coat.f0Colored.w != 0.0) coatDiffuseWeight=coat.colorStrength.rgb*(1.0-reflected)*strength;
    }

    bool thin=HasNativeThinSurface(coat);
    bool transmissionValid=HasNativeTransmissionModel(base.a,coat);
    float3 reflectionNormal=HasNativeEyeEnvironment(coat)?normalize(coat.normalRoughness.xyz):n;
    float coatRoughness=coat.normalRoughness.w;
#endif
    uint active = EnabledContributions & AvailableContributions;
    if ((active & ContributionIndirectDiffuse) != 0u)
    {
        float3 radiance = EnvironmentIrradiance(n) + SkyIrradiance(n);
        float3 diffuseRadiance = radiance * (lobes.diffuse + coatDiffuseWeight);
        Lighting.Store2(outputOffset, PackOpaqueRadiance(diffuseRadiance, ContributionIndirectDiffuse));
        if ((active & ContributionTransmission) != 0u) {
            float3 backRadiance=0.0;
            if (thin && any(backTransmissionWeight>0.0)) {
                backRadiance = EnvironmentIrradiance(-n) + SkyIrradiance(-n);
            }
            Lighting.Store2(outputOffset+16u,PackOpaqueRadiance(radiance*transmissionWeight+backRadiance*backTransmissionWeight,transmissionValid ? ContributionTransmission : 0u));
        }
    }
    if ((active & ContributionIndirectSpecular) != 0u)
    {
        float3 r = reflect(-baseView, reflectionNormal);
        // Eye environment direction is not a replacement for the direct BRDF normal.
        float3 radiance = ResolveRayReflection(pixel,world,n,r,roughness,0u,CubemapSpecularMiss(r,roughness));
        float3 specularRadiance = radiance * lobes.specular;
        if (hasCoat) {
            float3 cr=reflect(-view,cn);
            float3 crRadiance=ResolveRayReflection(pixel,world,cn,cr,coatRoughness,1u,CubemapSpecularMiss(cr,coatRoughness));
            specularRadiance += crRadiance*coatSpecularWeight;
        }
        Lighting.Store2(outputOffset + 8u, PackOpaqueRadiance(specularRadiance, ContributionIndirectSpecular));
    }
}
