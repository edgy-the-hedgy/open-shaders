#include "NativePBRBRDF.hlsli"

Texture2D<uint2> IdentityAndColor : register(t0);
Texture2D<float4> UVAndDdx : register(t1);
Texture2D<float4> DdyDepthFacing : register(t2);
Texture2D<float4> Basis0 : register(t3);
Texture2D<float4> Basis1 : register(t4);
Texture2D<float4> Basis2 : register(t5);
Texture2D<float4> ProjectedWorldPosition : register(t6);
Texture2D<float4> ProjectedDirection : register(t7);

struct DrawBinding
{
	uint2 identity;
	uint2 revision;
	uint materialIndex;
	uint flags;
};

StructuredBuffer<DrawBinding> DrawBindings : register(t8);
StructuredBuffer<NativePBR::MaterialRecord> MaterialRecords : register(t9);
Texture2DArray<float4> TexturePages[512] : register(t0, space1);
SamplerState ClampClampSampler : register(s0);
SamplerState ClampWrapSampler : register(s1);
SamplerState WrapClampSampler : register(s2);
SamplerState WrapWrapSampler : register(s3);

RWTexture2D<float4> BaseOpacity : register(u0);
RWTexture2D<float4> NormalRoughness : register(u1);
RWTexture2D<float4> F0Metallic : register(u2);
RWTexture2D<float4> EmissionAO : register(u3);
RWTexture2D<uint> MaterialCoverage : register(u4);

cbuffer NativePBRConstants : register(b0)
{
	uint2 Size;
	uint DrawCount;
	uint MaterialCount;
	uint PageCount;
};

float4 SampleTexture(uint2 location, uint clampMode, float2 uv, float2 uvDx, float2 uvDy, float4 fallback)
{
	if (location.x == NativePBR::MissingTexture || location.x >= min(PageCount, 512u))
		return fallback;
	uint width, height, slices, mips;
	TexturePages[NonUniformResourceIndex(location.x)].GetDimensions(0, width, height, slices, mips);
	if (width == 0u || height == 0u || location.y >= slices || mips == 0u)
		return fallback;
	float3 coordinates = float3(uv, location.y);
	if (clampMode == 0u)
		return TexturePages[NonUniformResourceIndex(location.x)].SampleGrad(ClampClampSampler, coordinates, uvDx, uvDy);
	if (clampMode == 1u)
		return TexturePages[NonUniformResourceIndex(location.x)].SampleGrad(ClampWrapSampler, coordinates, uvDx, uvDy);
	if (clampMode == 2u)
		return TexturePages[NonUniformResourceIndex(location.x)].SampleGrad(WrapClampSampler, coordinates, uvDx, uvDy);
	return TexturePages[NonUniformResourceIndex(location.x)].SampleGrad(WrapWrapSampler, coordinates, uvDx, uvDy);
}

[numthreads(8, 8, 1)]
void main(uint3 threadId : SV_DispatchThreadID)
{
	if (any(threadId.xy >= Size))
		return;
	uint2 pixel = threadId.xy;
	MaterialCoverage[pixel] = 0u;
	BaseOpacity[pixel] = 0.0f;
	NormalRoughness[pixel] = 0.0f;
	F0Metallic[pixel] = 0.0f;
	EmissionAO[pixel] = 0.0f;
	uint2 identityAndColor = IdentityAndColor[pixel];
	uint ordinal = identityAndColor.x;
	if (ordinal == 0u || ordinal > DrawCount)
		return;
	DrawBinding binding = DrawBindings[ordinal - 1u];
	if (binding.materialIndex >= MaterialCount)
		return;
	NativePBR::MaterialRecord record = MaterialRecords[binding.materialIndex];
	if (any(binding.identity != record.identity.xy) || any(binding.revision != record.identity.zw))
		return;
	NativePBR::SurfaceInput surface;
	float4 uvDdx = UVAndDdx[pixel];
	float4 ddyDepthFacing = DdyDepthFacing[pixel];
	float3 basis0 = Basis0[pixel].xyz;
	float3 basis1 = Basis1[pixel].xyz;
	float3 basis2 = Basis2[pixel].xyz;
	surface.uv = uvDdx.xy;
	surface.uvDx = uvDdx.zw;
	surface.uvDy = ddyDepthFacing.xy;
	surface.tangent = float3(basis0.x, basis1.x, basis2.x);
	surface.bitangent = float3(basis0.y, basis1.y, basis2.y);
	surface.geometricNormal = float3(basis0.z, basis1.z, basis2.z);
	surface.vertexColor = float3(identityAndColor.y & 255u,
		(identityAndColor.y >> 8) & 255u, (identityAndColor.y >> 16) & 255u) / 255.0f;
	surface.facing = ddyDepthFacing.w;
	float2 uv = surface.uv * record.uv[0].zw + record.uv[0].xy;
	float2 uvDx = surface.uvDx * record.uv[0].zw;
	float2 uvDy = surface.uvDy * record.uv[0].zw;
	float4 base = SampleTexture(record.textures[0].xy, record.properties.z, uv, uvDx, uvDy, 1.0f);
	float4 normal = SampleTexture(record.textures[0].zw, record.properties.z, uv, uvDx, uvDy, float4(0.5f, 0.5f, 1.0f, 1.0f));
	float4 packed = SampleTexture(record.textures[1].xy, record.properties.z, uv, uvDx, uvDy, float4(1.0f, 0.0f, 1.0f, 1.0f));
	float4 emission = SampleTexture(record.textures[1].zw, record.properties.z, uv, uvDx, uvDy, 0.0f);
	NativePBR::SurfaceMaterial material = NativePBR::EvaluateOpaque(record, surface, base, normal, packed, emission, binding.flags);
	BaseOpacity[pixel] = float4(material.baseColor, material.opacity);
	NormalRoughness[pixel] = float4(material.normal, material.roughness);
	F0Metallic[pixel] = float4(material.f0, material.metallic);
	EmissionAO[pixel] = float4(material.emission, material.ao);
	MaterialCoverage[pixel] = ordinal;
}
