#include "Common/NativeCubeDirection.hlsli"
#include "NativeEnvironmentColor.hlsli"
#include "NativeSurface.hlsli"
#include "Common/Spherical Harmonics/SphericalHarmonics.hlsli"

TextureCube<float4> Source : register(t0);
TextureCube<float4> Previous : register(t1);
TextureCube<float4> EngineReflection : register(t2);
ByteAddressBuffer NativeMaterials : register(t3);
ByteAddressBuffer NativeEnvironmentRadiance : register(t4);
ByteAddressBuffer RasterEvidence : register(t5);
RWTexture2DArray<float4> Destination : register(u0);
SamplerState PointClamp : register(s0);
SamplerState LinearClamp : register(s1);
cbuffer Environment : register(b0)
{
    float4 DALC[3];
    uint Encoding;
    uint HasHistory;
    uint HasReflection;
    uint FrameDelta;
};
cbuffer Dispatch : register(b1)
{
    uint Size;
    uint Mip;
    uint Mips;
    uint Reflection;
};
cbuffer NativeCapture : register(b2)
{
    row_major float4x4 NativeView;
    row_major float4x4 NativeProjection;
    uint2 NativeSize;
    uint NativeMaterialPitch;
    uint NativeRadiancePitch;
};

// The outgoing diffuse, emission and thin transmission are usable for
// environment observation, not proof of complete opaque raster replacement.
// Do not feed previous indirect light or view-dependent specular into history.
bool ReadNativeRadiance(float3 direction, out float3 radiance)
{
    radiance = 0;
    if (any(NativeSize == 0)) return false;
    float3 v = mul((float3x3)NativeView, -direction);
    if (v.z >= 0) return false;
    float4 clip = mul(NativeProjection,float4(v,0));
    if (!all(isfinite(clip)) || abs(clip.w) < 1e-8) return false;
    float2 uv = clip.xy/clip.w*float2(0.5,-0.5)+0.5;
    if (any(uv < 0) || any(uv >= 1)) return false;
    uint2 pixel = min(uint2(uv*float2(NativeSize)),NativeSize-1u);
    uint evidence = RasterEvidence.Load((pixel.y*NativeSize.x+pixel.x)*4u);
    if ((evidence & RasterIdentityCandidate) == 0u) return false;
    const uint signal = pixel.y*NativeRadiancePitch+pixel.x*8u;
    const float4 value = UnpackNativeLobeHalf4(NativeEnvironmentRadiance.Load2(signal));
    if (!all(isfinite(value)) || value.a != float(ContributionDirectDiffuse)) return false;
    radiance = max(value.rgb,0);
    return all(isfinite(radiance)) && all(radiance <= 65504);
}

float3 Encode(float3 c)
{
    c = max(c,0);
    if (Encoding == 0) return pow(c, 1.0/1.6);
    if (Encoding == 2) return max(0,sRGBToAP1(c));
    return c;
}
float3 SceneRadiance(float3 c)
{
    return pow(max(c,0),1.6);
}
[numthreads(8,8,1)]
void historyMain(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= Size) || id.z >= 6) return;
    float3 d = NativeCubeDirection(id, Size);
    float3 nativeRadiance;
    if (ReadNativeRadiance(d,nativeRadiance)) {
        Destination[id] = float4(nativeRadiance,1);
        return;
    }
    float4 captured = Source.SampleLevel(PointClamp,d,0);
    if (abs(captured.a) > 0) {
        Destination[id] = float4(SceneRadiance(captured.rgb), sign(captured.a));
        return;
    }
    if (HasHistory != 0) {
        captured = Previous.SampleLevel(PointClamp,d,0);
        float age = abs(captured.a) + float(FrameDelta);
        // Never refresh the age of inferred or unobserved directions.
        if (abs(captured.a) > 0 && age <= 1800.0) {
            Destination[id] = float4(captured.rgb, sign(captured.a)*age);
            return;
        }
    }
    Destination[id] = 0;
}
float3 Fallback(float3 direction)
{
    if (Reflection != 0 && (HasReflection & 1u) != 0u)
        // Engine reflections are irradiance-encoded; the raw main capture is scene-gamma.
        return max(0,DecodeEnvironmentRadiance(EngineReflection.SampleLevel(LinearClamp,direction,0).rgb,Encoding));
    float4 basis = SphericalHarmonics::Evaluate(direction);
    float3 gamma = max(0,float3(dot(DALC[0],basis),dot(DALC[1],basis),dot(DALC[2],basis)));
    return Encoding == 0 ? SceneRadiance(gamma) : lerp(gamma/12.92,pow((gamma+0.055)/1.055,2.4),step(0.04045,gamma));
}
float3 Resolve(float3 direction)
{
    float4 c = Source.SampleLevel(PointClamp,direction,0);
    if (c.a > 0 || (Reflection != 0 && (HasReflection & 2u) != 0u && c.a < 0))
        return c.rgb;
    return Fallback(direction);
}
[numthreads(8,8,1)]
void main(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= Size) || id.z >= 6) return;
    float3 n = NativeCubeDirection(id,Size);
    if (Mip == 0) {
        Destination[id] = float4(min(Encode(Resolve(n)),65504),1);
        return;
    }
    float3 t = normalize(cross(abs(n.z)<0.999 ? float3(0,0,1) : float3(1,0,0), n));
    float3 b = cross(n,t);
    float roughness = float(Mip)/max(1.0,float(Mips-1));
    float a = max(0.001,roughness*roughness);
    float3 sum = 0;
    float weight = 0;
    [unroll] for (uint i=0;i<32;++i) {
        float2 xi = float2((float(i)+0.5)/32.0,float(reversebits(i))*2.3283064365386963e-10);
        float phi = 6.28318530718 * xi.x;
        float cosTheta = sqrt((1-xi.y)/(1+(a*a-1)*xi.y));
        float sinTheta = sqrt(max(0,1-cosTheta*cosTheta));
        float3 h = t*(cos(phi)*sinTheta)+b*(sin(phi)*sinTheta)+n*cosTheta;
        float3 l = reflect(-n,h);
        float ndl = saturate(dot(n,l));
        if (ndl > 0) { sum += Resolve(l)*ndl; weight += ndl; }
    }
    Destination[id] = float4(min(Encode(weight>0 ? sum/weight : Resolve(n)),65504),1);
}
