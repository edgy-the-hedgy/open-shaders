Texture2D<float4> MaterialUV : register(t0);
Texture2D<float4> GeometricNormal : register(t1);
Texture2D<float4> VertexColor : register(t2);
Texture2D<float2> MaterialIdentity : register(t3);
RWTexture2D<float4> Scene : register(u0);

cbuffer NativePBRConstants : register(b0)
{
	uint2 Size;
};

[numthreads(8, 8, 1)]
void main(uint3 threadId : SV_DispatchThreadID)
{
	if (any(threadId.xy >= Size))
		return;
	const uint2 pixel = threadId.xy;
	const float2 identity = MaterialIdentity[pixel];
	const uint signature = (uint)round(saturate(identity.y) * 65535.0);
	if (signature != 0xA55A && signature != 0x5AA5)
		return;
	const uint ordinal = (uint)round(saturate(identity.x) * 65535.0);
	if (ordinal == 0 || ordinal > 1024)
		return;
	const float3 encodedNormal = GeometricNormal[pixel].rgb;
	const float3 normal = normalize(encodedNormal * 2.0 - 1.0);
	const float3 direction = normalize(float3(0.35, 0.45, 0.82));
	const float diffuse = 0.2 + 0.8 * saturate(dot(normal, direction));
	const float3 tint = saturate(VertexColor[pixel].rgb);
	const float2 uv = saturate(MaterialUV[pixel].rg);
	const float3 color = tint * diffuse * lerp(0.8, 1.0, frac(uv.x * 12.0) * frac(uv.y * 12.0));
	const float3 projected = lerp(color, color * float3(0.65, 0.85, 1.0), signature == 0x5AA5 ? 0.4 : 0.0);
	const float4 original = Scene[pixel];
	Scene[pixel] = float4(projected, original.a);
}
