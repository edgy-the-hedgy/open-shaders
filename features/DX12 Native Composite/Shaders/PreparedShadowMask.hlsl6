RaytracingAccelerationStructure StaticScene : register(t0);
Texture2D<float> SceneDepth : register(t1);

struct PreparedLight
{
	float4 positionRadius;
	float4 colorFade;
	float4 emitterFalloff;
};
StructuredBuffer<PreparedLight> Lights : register(t2);
RWTexture2D<float> ShadowMask : register(u0);

cbuffer Camera : register(b0)
{
	row_major float4x4 ProjectionInverse;
	row_major float4x4 ViewInverse;
	float4 CameraAdjust;
	uint2 Size;
	uint LightCount;
	float ShadowIntensity;
	uint SamplingMode;
	uint SamplingPhase;
	uint2 SamplingPadding;
};

bool TraceShadowAtPixel(uint2 pixel, uint mode, uint phase)
{
	// Frame-dependent sparse sampling changes which pixel is traced without
	// adding an uninitialized or misleading shadow value to skipped pixels.
	if (mode == 0)
		return true;
	if (mode == 1 || mode == 4) {
		const uint slot = (pixel.x + 2u * pixel.y + phase) % 3u;
		return mode == 1 ? slot < 2u : slot == 0u;
	}
	if (mode == 2)
		return ((pixel.x + pixel.y + phase) & 1u) == 0u;
	if (mode == 3 || mode == 7) {
		const uint slot = (pixel.x % 3u + 3u * (pixel.y % 3u) + phase) % 9u;
		return slot < (mode == 3 ? 4u : 1u);
	}
	if (mode == 5)
		return ((pixel.x & 1u) + 2u * (pixel.y & 1u) + phase) % 4u == 0u;
	if (mode == 6)
		return ((pixel.x % 3u) + 3u * (pixel.y & 1u) + phase) % 6u == 0u;
	return true;
}

[numthreads(8, 8, 1)]
void main(uint3 dispatchThread : SV_DispatchThreadID)
{
	uint2 pixel = dispatchThread.xy;
	if (any(pixel >= Size))
		return;
	if (!TraceShadowAtPixel(pixel, SamplingMode, SamplingPhase)) {
		ShadowMask[pixel] = 1.0;
		return;
	}
	const float depth = SceneDepth.Load(int3(pixel, 0));
	const float2 uv = (float2(pixel) + 0.5) / float2(Size);
	float4 view = mul(ProjectionInverse, float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0));
	if (abs(view.w) < 1e-6) {
		ShadowMask[pixel] = 1.0;
		return;
	}
	view /= view.w;
	const float3 receiver = mul(ViewInverse, float4(view.xyz, 1.0)).xyz + CameraAdjust.xyz;
	float visibleWeight = 0.0;
	float totalWeight = 0.0;
	[loop]
	for (uint index = 0; index < LightCount; ++index) {
		const PreparedLight light = Lights[index];
		const float3 centerOffset = light.positionRadius.xyz - receiver;
		const float distance = length(centerOffset);
		const float radius = light.positionRadius.w;
		if (distance <= 4.0 || distance >= radius)
			continue;
		const float range = saturate(1.0 - distance / radius);
		const float energy = max(dot(light.colorFade.rgb, float3(0.2126, 0.7152, 0.0722)) * light.colorFade.a, 0.0);
		const float weight = pow(range, clamp(light.emitterFalloff.y, 0.01, 8.0)) * energy;
		if (weight < 0.001)
			continue;
		totalWeight += weight;
		float3 direction = centerOffset / distance;
		const float emitterRadius = min(max(light.emitterFalloff.x, 0.0), distance * 0.25);
		if (emitterRadius > 0.01) {
			uint seed = pixel.x * 747796405u + pixel.y * 2891336453u + index * 277803737u;
			seed = (seed ^ (seed >> 16)) * 2246822519u;
			const float a = float(seed & 65535u) * (6.28318530718 / 65536.0);
			const float r = emitterRadius * sqrt(float(seed >> 16) / 65535.0);
			const float3 tangent = normalize(cross(abs(direction.z) < 0.9 ? float3(0, 0, 1) : float3(0, 1, 0), direction));
			const float3 bitangent = cross(direction, tangent);
			direction = normalize(centerOffset + r * (cos(a) * tangent + sin(a) * bitangent));
		}
		RayDesc ray;
		ray.Direction = direction;
		ray.Origin = receiver + ray.Direction * 2.0;
		ray.TMin = 0.0;
		ray.TMax = distance - 4.0;
		RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
		query.TraceRayInline(StaticScene, RAY_FLAG_NONE, 1, ray);
		while (query.Proceed()) {}
		if (query.CommittedStatus() == COMMITTED_NOTHING)
			visibleWeight += weight;
	}
	const float rawVisibility = totalWeight > 0.001 ? saturate(visibleWeight / totalWeight) : 1.0;
	// Strength above 1 is meaningful: deepen partial visibility and clamp to
	// a physically valid [0,1] mask. Final raster color remains untouched.
	ShadowMask[pixel] = saturate(1.0 - (1.0 - rawVisibility) * clamp(ShadowIntensity, 0.0, 4.0));
}
