// DX12 screen-space receiver resolve, direct RayQuery per prepared light.
// No depth atlas, screen-facing light culling or raster direct-light dependency.
// One uint4 contains 64 per-light coverage bits and 64 occlusion bits.
RaytracingAccelerationStructure StaticScene : register(t0);
Texture2D<float> SceneDepth : register(t1);

struct PreparedLight { float4 positionRadius; float4 colorFade; float4 emitterFalloff; };
StructuredBuffer<PreparedLight> Lights : register(t2);
RWTexture2DArray<uint4> ShadowBits : register(u0);

cbuffer Camera : register(b0)
{
    row_major float4x4 ProjectionInverse;
    row_major float4x4 ViewInverse;
    float4 CameraAdjust;
    uint2 Size;
    uint LightCount;
    float ShadowIntensity;
    uint SamplingMode;
    uint SamplingPhase;
    uint SpatialReconstruction;
    uint BatchIndex;
};

bool TraceShadowAtPixel(uint2 p, uint mode, uint phase)
{
    if (mode == 0) return true;
    if (mode == 1 || mode == 4) {
        uint s = (p.x + 2u * p.y + phase) % 3u;
        return mode == 1 ? s < 2u : s == 0u;
    }
    if (mode == 2) return ((p.x + p.y + phase) & 1u) == 0u;
    if (mode == 3 || mode == 7) {
        uint s = (p.x % 3u + 3u * (p.y % 3u) + phase) % 9u;
        return s < (mode == 3 ? 4u : 1u);
    }
    if (mode == 5) return ((p.x & 1u) + 2u * (p.y & 1u) + phase) % 4u == 0u;
    if (mode == 6) return ((p.x % 3u) + 3u * (p.y & 1u) + phase) % 6u == 0u;
    return true;
}

[numthreads(8,8,1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint2 pixel = tid.xy;
    if (any(pixel >= Size)) return;
    if (!TraceShadowAtPixel(pixel, SamplingMode, SamplingPhase)) {
        ShadowBits[uint3(pixel, BatchIndex)] = uint4(0,0,0,0);
        return;
    }
    const float depth = SceneDepth.Load(int3(pixel, 0));
    const float2 uv = (float2(pixel) + 0.5) / float2(Size);
    float4 view = mul(ProjectionInverse, float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0));
    if (abs(view.w) < 1e-6) {
        ShadowBits[pixel] = uint4(0,0,0,0);
        return;
    }
    view /= view.w;
    const float3 receiver = mul(ViewInverse, float4(view.xyz, 1.0)).xyz + CameraAdjust.xyz;
    uint4 results = uint4(0,0,0,0);
    // Ray from visible receiver to world-space emitter: emitters never have
    // to be on-screen. Each batch contributes its own per-light bitset layer.
    [loop] for (uint i = 0; i < 64u && BatchIndex * 64u + i < LightCount; ++i) {
        const PreparedLight light = Lights[BatchIndex * 64u + i];
        const float3 toLight = light.positionRadius.xyz - receiver;
        const float distance = length(toLight);
        const float radius = light.positionRadius.w;
        if (distance <= max(0.01, radius * 0.0001) || distance >= radius) continue;
        const float weight = pow(saturate(1.0 - distance / radius), clamp(light.emitterFalloff.y, 0.01, 8.0));
        if (weight < 0.001) continue;
        const uint bit = 1u << (i & 31u);
        if (i < 32u) results.z |= bit; else results.w |= bit;
        RayDesc ray;
        ray.Origin = receiver;
        ray.Direction = toLight / distance;
        ray.TMin = max(0.01, distance * 0.001);
        ray.TMax = distance - ray.TMin;
        if (ray.TMax <= ray.TMin) continue;
        RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
        query.TraceRayInline(StaticScene, RAY_FLAG_NONE, 1, ray);
        while (query.Proceed()) {}
        if (query.CommittedStatus() != COMMITTED_NOTHING) {
            if (i < 32u) results.x |= bit; else results.y |= bit;
        }
    }
    ShadowBits[uint3(pixel, BatchIndex)] = results;
}
