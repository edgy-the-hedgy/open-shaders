// Per-logical-cell temporal surface validation for native Hybrid RR.
// Each quarter cell rotates representative native pixels across frames.
// Reject only cells that change physical surface; keep histories for flat
// contiguous surfaces. No pre-RR radiance filtering/averaging is performed.
Texture2D<float> CurrentDepth : register(t0);
Texture2D<float4> CurrentMotion : register(t1);
Texture2D<float4> CurrentNormal : register(t2);
Texture2D<float> PreviousDepth : register(t3);
Texture2D<float4> PreviousNormal : register(t4);
RWTexture2D<float4> ValidatedMotion : register(u0);

cbuffer NativeRRHistoryPolicy : register(b0)
{
    uint2 LogicalSize;
    float DepthTolerance;
    float NormalThreshold;
    float RoughnessThreshold;
    float3 Reserved;
};

float3 DecodeNormal(float2 p)
{
    float2 f = p * 2.0 - 1.0;
    float3 n = float3(f, 1.0 - abs(f.x) - abs(f.y));
    float t = saturate(-n.z);
    n.xy += float2(n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
    return normalize(n);
}

[numthreads(8, 8, 1)]
void main(uint2 pixel : SV_DispatchThreadID)
{
    if (any(pixel >= LogicalSize)) return;
    float4 motion = CurrentMotion.Load(int3(pixel, 0));
    float depth = CurrentDepth.Load(int3(pixel, 0));
    float4 normal = CurrentNormal.Load(int3(pixel, 0));
    bool valid = isfinite(depth) && depth > 0.0 && all(isfinite(motion)) &&
        all(isfinite(normal)) && motion.w > 0.5;
    int2 prevPixel = int2(0, 0);
    if (valid) {
        // Engine motion is normalized screen-space displacement, not pixels.
        // Only cells whose reprojected previous receiver matches may retain
        // temporal history when the representative phase changes.
        float2 previousLocation = float2(pixel) + motion.xy * float2(LogicalSize);
        valid = all(previousLocation >= 0.0) &&
            all(previousLocation < float2(LogicalSize));
        prevPixel = int2(floor(previousLocation + 0.5));
        prevPixel = clamp(prevPixel, int2(0, 0), int2(LogicalSize) - 1);
    }
    if (valid) {
        float oldDepth = PreviousDepth.Load(int3(prevPixel, 0));
        float4 oldNormal = PreviousNormal.Load(int3(prevPixel, 0));
        float predictedDepth = depth + motion.z;
        float relativeDifference = abs(oldDepth - predictedDepth) /
            max(abs(predictedDepth), 0.001);
        valid = isfinite(oldDepth) && oldDepth > 0.0 &&
            all(isfinite(oldNormal)) &&
            relativeDifference <= DepthTolerance &&
            dot(DecodeNormal(normal.xy), DecodeNormal(oldNormal.xy)) >= NormalThreshold &&
            abs(normal.z - oldNormal.z) <= RoughnessThreshold;
    }
    // An out-of-frame reprojection is a per-pixel RR history rejection,
    // not a global reset of all otherwise stable quarter-resolution cells.
    ValidatedMotion[pixel] = valid ? motion : float4(4.0, 4.0, 0.0, 0.0);
}
