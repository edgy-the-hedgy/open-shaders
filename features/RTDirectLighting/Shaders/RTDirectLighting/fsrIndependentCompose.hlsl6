// Dedicated FSR Hybrid Independent DX12 compositor.
// Reads AMD RR outputs only. No native denoiser, history, or shadow-mask input.
Texture2D<float4> RasterScene : register(t0);
Texture2D<float4> TaggedDirect : register(t1);
Texture2D<float4> DirectDiffuseRR : register(t2);
Texture2D<float4> DirectSpecularRR : register(t3);
Texture2D<float4> DirectDiffuseAlbedo : register(t4);
Texture2D<float4> DirectSpecularAlbedo : register(t5);
Texture2D<float4> IndirectDiffuseRR : register(t6);
Texture2D<float4> IndirectSpecularRR : register(t7);
Texture2D<float> DiffuseAORR : register(t8);
Texture2D<float> SpecularAORR : register(t9);
Texture2D<float4> RasterAlbedo : register(t10);
Texture2D<float4> RasterReflectance : register(t11);
Texture2D<float> LinearDepth : register(t12);
Texture2D<float4> RasterNormalRoughness : register(t13);
Texture2D<float4> Receivers : register(t14);
Texture2D<float4> RawDirectDiffuse : register(t15);
Texture2D<float4> RawDirectSpecular : register(t16);
RWTexture2D<float4> OutScene : register(u0);
cbuffer FSRIndependentComposition : register(b0)
{
    uint2 FrameSize;
    uint2 GISize;
    uint FrameIndex;
    uint LinearLighting;
    float DirectBlend;
    float GIContribution;
    uint DirectRRMask;
    uint HybridRRMask;
    uint CheckerboardPolicy;
    uint Reserved;
};
[numthreads(8,8,1)]
void main(uint2 pixel : SV_DispatchThreadID)
{
    if (any(pixel >= FrameSize)) return;
    const float4 raster = RasterScene.Load(int3(pixel, 0));
    const float3 baseline = all(isfinite(raster.rgb)) ?
        max(raster.rgb, 0.0) : 0.0;
    float3 color = LinearLighting != 0u ? baseline : pow(baseline, 1.6);
    // Direct RR outputs are full-native. An unavailable family uses only
    // its actual traced checkerboard anchor, without inventing coverage.
    const uint2 anchor = uint2(min((pixel.x & ~1u) +
        ((pixel.y + FrameIndex) & 1u), FrameSize.x - 1u), pixel.y);
    const float4 tagged = TaggedDirect.Load(int3(anchor, 0));
    const bool traced = tagged.a == 4.0 && all(isfinite(tagged));
    const bool rawHere = traced && all(pixel == anchor);
    const float4 rawD = RawDirectDiffuse.Load(int3(anchor, 0));
    const float4 rawS = RawDirectSpecular.Load(int3(anchor, 0));
    const float4 albedoD = DirectDiffuseAlbedo.Load(int3(anchor, 0));
    const float4 albedoS = DirectSpecularAlbedo.Load(int3(anchor, 0));
    const float4 d = (DirectRRMask & 1u) != 0u ?
        DirectDiffuseRR.Load(int3(pixel, 0)) :
        (rawHere ? rawD : float4(0, 0, 0, -1));
    const float4 s = (DirectRRMask & 2u) != 0u ?
        DirectSpecularRR.Load(int3(pixel, 0)) :
        (rawHere ? rawS : float4(0, 0, 0, -1));
    const bool validD = all(isfinite(d)) && all(d.rgb >= 0.0) &&
        ((DirectRRMask & 1u) != 0u || rawHere);
    const bool validS = all(isfinite(s)) && all(s.rgb >= 0.0) &&
        ((DirectRRMask & 2u) != 0u || rawHere);
    if ((validD || validS) && all(isfinite(albedoD)) && all(isfinite(albedoS))) {
        const float3 emission = traced && all(isfinite(rawD)) &&
            all(isfinite(rawS)) && isfinite(albedoS.a) ?
            max(float3(rawD.a, rawS.a, albedoS.a), 0.0) : 0.0;
        const float3 directLighting =
            (validD ? max(d.rgb, 0.0) * max(albedoD.rgb, 0.0) : 0.0) +
            (validS ? max(s.rgb, 0.0) * max(albedoS.rgb, 0.0) : 0.0) +
            emission;
        if (all(isfinite(directLighting)))
            color = lerp(color, directLighting, saturate(DirectBlend));
    }

    // Raw HybridGI uses its actual packed signal grid. Only vendor-produced
    // RR outputs cover unsampled checkerboard lanes. No native spatial or
    // temporal reconstruction, history test, or post-RR rejection is applied.
    if (GISize.x != 0u && GISize.y != 0u) {
        const uint2 logical = min(
            uint2((float2(pixel) + 0.5) * float2(GISize) / float2(FrameSize)),
            GISize - 1u);
        const bool checkerboard = (CheckerboardPolicy & 1u) != 0u;
        const bool sampled = !checkerboard ||
            ((logical.x + logical.y) & 1u) == ((CheckerboardPolicy >> 1u) & 1u);
        const uint2 packed = uint2(checkerboard ? logical.x >> 1u : logical.x, logical.y);
        const bool rrD = (HybridRRMask & 1u) != 0u;
        const bool rrS = (HybridRRMask & 2u) != 0u;
        const bool rrAO = (HybridRRMask & 4u) != 0u;
        const float4 giD = rrD ?
            IndirectDiffuseRR.Load(int3(logical, 0)) :
            (sampled ? IndirectDiffuseRR.Load(int3(packed, 0)) : float4(0, 0, 0, -1));
        const float4 giS = rrS ?
            IndirectSpecularRR.Load(int3(logical, 0)) :
            (sampled ? IndirectSpecularRR.Load(int3(packed, 0)) : float4(0, 0, 0, -1));
        const float aoD = rrAO ?
            DiffuseAORR.Load(int3(logical, 0)) :
            (sampled ? DiffuseAORR.Load(int3(packed, 0)) : 1.0);
        const float aoS = rrAO ?
            SpecularAORR.Load(int3(logical, 0)) :
            (sampled ? SpecularAORR.Load(int3(packed, 0)) : 1.0);
        const float4 albedo = RasterAlbedo.Load(int3(pixel, 0));
        const float4 reflectance = RasterReflectance.Load(int3(pixel, 0));
        const float pbrScale = LinearLighting != 0u ? 1.0 : 0.65;
        const float3 rawAlbedo = max(albedo.rgb / pbrScale, 0.0);
        const float3 diffuseFactor = LinearLighting != 0u ?
            rawAlbedo : pow(rawAlbedo, 1.6);
        if ((rrD || (sampled && giD.a >= 0.0)) &&
            all(isfinite(giD)) && all(isfinite(albedo)) && isfinite(aoD))
            color += max(giD.rgb, 0.0) * diffuseFactor *
                saturate(aoD) * saturate(GIContribution);
        if ((rrS || (sampled && giS.a >= 0.0)) &&
            all(isfinite(giS)) && all(isfinite(reflectance)) && isfinite(aoS))
            color += max(giS.rgb, 0.0) * max(reflectance.rgb, 0.0) *
                saturate(aoS) * saturate(GIContribution);
    }
    const float3 encoded = LinearLighting != 0u ?
        max(color, 0.0) : pow(max(color, 0.0), 1.0 / 1.6);
    OutScene[pixel] = float4(all(isfinite(encoded)) ? encoded : baseline,
        isfinite(raster.a) ? raster.a : 1.0);
}
