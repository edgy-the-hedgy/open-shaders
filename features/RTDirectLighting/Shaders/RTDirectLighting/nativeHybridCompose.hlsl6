// Stage 5B: DX12-native final radiance composition.
// The only DX11-facing product will be the completed scene; no GI/AO signal
// returns to D3D11. This pass intentionally consumes raw GI pending RR wiring.
Texture2D<float4> ShadowedRaster : register(t0);
Texture2D<float4> NativeDirect : register(t1);
Texture2D<float4> IndirectDiffuse : register(t2);
Texture2D<float4> IndirectSpecular : register(t3);
Texture2D<float> DiffuseAO : register(t4);
Texture2D<float> SpecularAO : register(t5);
Texture2D<uint> ReceiverEligibility : register(t6);
Texture2D<float4> DiffuseAlbedo : register(t7);
Texture2D<float4> SpecularAlbedo : register(t8);
Texture2D<float2> NativeShadowMask : register(t9);
RWTexture2D<float4> ComposedScene : register(u0);

cbuffer NativeHybridComposition : register(b13)
{
    uint2 FrameSize;
    float DirectBlend;
    float GIContribution;
    uint NativeLinearLighting;
    uint NativeEnableACEScg; // reserved for a full gamut-correct scene handoff
    uint ShadowAuraRadius; // fixed Hybrid-Shadowed = 3, Custom = 0
    float ShadowAuraInfluence;
};

float ExpandedDirectShadowVisibility(uint2 pixel)
{
    const int radius = min(int(ShadowAuraRadius), 3);
    float visibility = 1.0;
    [loop] for (int dy = -radius; dy <= radius; ++dy) {
        [loop] for (int dx = -radius; dx <= radius; ++dx) {
            const int2 neighbor = int2(pixel) + int2(dx, dy);
            if (any(neighbor < 0) || any(neighbor >= int2(FrameSize))) continue;
            const float2 mask = NativeShadowMask.Load(int3(neighbor, 0));
            if (all(isfinite(mask)) && mask.y >= 0.5)
                visibility = min(visibility, saturate(mask.x));
        }
    }
    return visibility;
}
[numthreads(8, 8, 1)]
void main(uint2 pixel : SV_DispatchThreadID)
{
    if (any(pixel >= FrameSize)) return;

    const float4 shadowed = ShadowedRaster.Load(int3(pixel, 0));
    float3 linearColor = all(isfinite(shadowed.rgb)) ? max(0.0, shadowed.rgb) : 0.0;

    // Matches RTDirectLighting/directContract.hlsli::DirectRadianceTag.
    // Unsupported or invalid direct receivers retain the shadowed raster.
    const float4 direct = NativeDirect.Load(int3(pixel, 0));
    if (direct.a == 4.0 && all(isfinite(direct.rgb)) && all(direct.rgb >= 0.0)) {
        float3 directRadiance = direct.rgb;
        if (ShadowAuraRadius != 0u) {
            const float visibility = ExpandedDirectShadowVisibility(pixel);
            const float attenuation = lerp(1.0, visibility, saturate(ShadowAuraInfluence));
            directRadiance *= attenuation;
        }
        linearColor = lerp(linearColor, directRadiance, saturate(DirectBlend));
    }

    // 0: intentional shadow-controlled GI skip; 1: GI evaluated;
    // 2: invalid receiver. No indirect history may resurrect 0 or 2.
    if (ReceiverEligibility.Load(int3(pixel, 0)) == 1u)
    {
        const float4 diffuse = IndirectDiffuse.Load(int3(pixel, 0));
        const float4 specular = IndirectSpecular.Load(int3(pixel, 0));
        const float aoDiffuse = DiffuseAO.Load(int3(pixel, 0));
        const float aoSpecular = SpecularAO.Load(int3(pixel, 0));
        if (all(isfinite(diffuse)) && all(isfinite(specular)) &&
            isfinite(aoDiffuse) && isfinite(aoSpecular))
        {
            const float pbrScale = NativeLinearLighting != 0u ? 1.0 : 0.65;
            const float3 diffuseFactor = NativeLinearLighting != 0u ?
                max(0.0, DiffuseAlbedo.Load(int3(pixel, 0)).rgb / pbrScale) :
                pow(abs(DiffuseAlbedo.Load(int3(pixel, 0)).rgb / pbrScale), 1.6);
            const float3 specularFactor = max(0.0, SpecularAlbedo.Load(int3(pixel, 0)).rgb);
            // Input to RR contains NO first-bounce albedo. Modulate exactly
            // once here, after RR and optional post-RR spatial reconstruction.
            if (all(isfinite(diffuseFactor)) && all(isfinite(specularFactor)))
                linearColor += saturate(GIContribution) *
                    (max(0.0, diffuse.rgb) * diffuseFactor * saturate(aoDiffuse) +
                     max(0.0, specular.rgb) * specularFactor * saturate(aoSpecular));
        }
    }

    // The game still presents a gamma-domain scene at this stage.
    // Keep the DX12 composition linear and encode exactly once for export.
    const float3 encoded = pow(max(0.0, linearColor), 1.0 / 1.6);
    ComposedScene[pixel] = float4(all(isfinite(encoded)) ? encoded : 0.0,
        isfinite(shadowed.a) ? shadowed.a : 1.0);
}
